;<--UserDefineStart-->.\IT31019A.lik
locate: PAGE0 at 0080h reference
locate: LCM_Driver_ZRAM		after PAGE0				;for EV use
locate: LCM_Driver_NRAM		after LCM_Driver_ZRAM	;for EV use
locate: LCD_ZRAM			after LCM_Driver_NRAM
locate: LCD_NRAM			after LCD_ZRAM
