   956                              ;;==========================================================	
   957                              ;;计算温湿度
   958                              ;;==========================================================  
   959                              ;L_CalcuRFC:	
   960                              		;==========================================================
   961                              		; Update Temperature Data for Display
   962                              		; RW_LastTem+1 (Packed BCD): Tens (High Nibble) | Units (Low Nibble)
   963                              		; RW_LastTem   (Decimal):    Decimal Digit (Might be >9, need limit)
   964                              		; Target: TempData+0 (Tens), TempData+1 (Units | Decimal)
   965                              		;==========================================================
   966                              ;		LDA		RW_LastTem+1	; Load Integer Part (Already Packed BCD)
   967                              ;		JSR		F_ByteHLValue	; A = Tens (High->Low), R_TempBuf = Units (Low Nibble)
   968                              ;		STA		TempData+0		; Store Tens Digit
   969                              ;		
   970                              ;		LDA		R_TempBuf		; Load Units Digit
   971                              ;		JSR		F_ByteLHValue	; Move Units to High Nibble (A = Units << 4)
   972                              ;		STA		R_TempBuf		; Save Units(High Nibble)
   973                              		
   974                              		; Process Decimal Part
   975                              ;		LDA		RW_LastTem		; Load Decimal Part
   976                              ;		CMP		#10				; Check if > 9
   977                              ;		BCC		?L_DecOK		; If < 10, jump
   978                              ;		LDA		#9				; Else, limit to 9
   979                              ;?L_DecOK:
   980                              ;		ORA		R_TempBuf		; Combine with Units(High Nibble)
   981                              ;		STA		TempData+1		; Store Units.Decimal
   982                              		
   983                              		;==========================================================
   984                              		; Update Humidity Data for Display
   985                              		; RB_HumDataBCD (Packed BCD): Tens (High Nibble) | Units (Low Nibble)
   986                              		; Target: HumData+0 (Packed BCD)
   987                              		;==========================================================
   988                              ;		LDA		RB_HumDataBCD
   989                              ;		STA		HumData+0		; Store Humidity Value
   990                              		
   991                              ;		RTS
   992                              			
   993                              ;================================================================
