   587                      <       ; Macro Name:	%FillLcdDpram
   588                      <       ; Description:	Fill LCD DPRAM $50 ~$5F
   589                      <       ;-----------------------------------------------------------------------------
   590                      <       %FillLcdDpram	.MACRO	mData
   591                      <       		
   592                      <       		%M_ClearWatchDog
   593                      <       		LDX		#00H
   594                      <       		LDA     mData
   595                      <       ?L_ClrDpramLoop:
   596                      <       		STA		$50,X
   597                      <       		INX
   598                      <       		CPX		#10H
   599                      <       		BNE		?L_ClrDpramLoop	
   600                      <       
   601                      <       	.ENDM
