   581                      <           LDA		#D_LCDMode_Normal+D_LCDSetting_3Bias_4Duty+D_LCDGreenMode_En
   582                      <       ;	LDA		#(D_LCDMode_Normal+D_LCDSetting_3Bias_4Duty)
