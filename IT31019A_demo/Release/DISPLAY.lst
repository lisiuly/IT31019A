   551                      <       	STA	P_INT_Ctrl0
   552                      <       	LDA	#FFH	
   553                      <       	STA	P_INT_Clear0
   554                      <       	
   555                      <       	LDA	#00H
   556                      <       	STA	P_INT_Ctrl1
