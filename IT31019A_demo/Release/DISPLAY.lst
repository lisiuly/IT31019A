   399                      <       ; Parameter     : LCM_Buffer_Ptr
   400                      <       ; Return        : None ; Check sum = R_LCM_DataLength + address1 + data1 + 
   401                      <       ;                       	          address2 + data2 + ....  + addressN + dataN
