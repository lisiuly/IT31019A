   935 0000ECE6                     F_DisplayAllMode:		
   936                              		%btsf	R_TimeStatus,AddOthers,?NoDisplayAllLCD				
   937 0000ECE6 AD B7 00          1           lda     R_TimeStatus               ;ex.   
   938 0000ECE9 29 01             1           and     #AddOthers              ;  %btsf 10H,_BIT0,N
   939 0000ECEB F0 18             1           beq     ?NoDisplayAllLCD               ;  if(10H.0=0) goto N 
   940 0000ECED                     	?DisplayAll:
   941                              		%bitr	R_TimeStatus,AddOthers
   942 0000ECED AD B7 00          1           lda     R_TimeStatus               ;ex.  
   943 0000ECF0 29 FE             1           and     #.NOT.AddOthers         ;  %bitr 10H,_BIT0;  10H.0=0
   944 0000ECF2 8D B7 00          1           sta     R_TimeStatus
   945 0000ECF5 20 5E EE            		JSR		F_JudgeDispCF
   946 0000ECF8 20 06 ED            		JSR		F_DisplayTemperaute
   947 0000ECFB 20 2A EE            		JSR		F_DisplayHumidity
   948 0000ECFE 20 81 EE            		JSR		F_DispCurrentHum
   949 0000ED01 20 D6 EE            		JSR		Display_Weather
   950 0000ED04 60                  		RTS
