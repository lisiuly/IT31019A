   508                      <       ; Macro Name:	%FillSram
   509                      <       ; Description:	Fill data to SRAM $80 ~ $fF
   510                      <       ; Input:		mData
   511                      <       ;==========================================
   512                      <       %RAM_Init:		.MACRO	
   513                      <       		LDy		#0
   514                      <       		LDA		#0	
   515                      <       ?L_FillRAMLOOP:	
   516                      <       		STA		$80,y
   517                      <       		INy
   518                      <       		CPy		#128
   519                      <       		BCC		?L_FillRAMLOOP
   520                      <       .ENDM
