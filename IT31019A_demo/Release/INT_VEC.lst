   624                      <       ;/***********************************************/
   625                      <       ;         i.L=1 
   626                      <       %bits:   .MACRO   i,L             ;BYTE i;  
   627                      <                 lda     i               ;ex.  
   628                      <                 ora     #L              ;  %bits 10H,_BIT0  ;  10H.0=1
   629                      <                 sta     i               ;
   630                      <                .ENDM    
   631                      <       
   632                      <       ;/***********************************************/
   633                      <       ;         i.L=0
   634                      <       %bitr:   .MACRO   i,L             ;BYTE i;  
   635                      <                 lda     i               ;ex.  
   636                      <                 and     #.NOT.L         ;  %bitr 10H,_BIT0;  10H.0=0
   637                      <                 sta     i
   638                      <                .ENDM    
   639                      <       
   640                      <       ;/***********************************************/
   641                      <       ;         if(i.L==1) goto N
   642                      <       %btst:   .MACRO   i,L,N           ;BYTE i;  
   643                      <                 lda     i               ;ex.   
   644                      <                 and     #L              ;  %btst 10H,_BIT0,N
   645                      <                 bne     N               ;  if(10H.0=1) goto N 
   646                      <                .ENDM    
   647                      <                                         
   648                      <       ;/***********************************************/
   649                      <       ;         if(i.L==0) goto N
   650                      <       %btsf:   .MACRO   i,L,N           ;BYTE i;    
   651                      <                 lda     i               ;ex.   
   652                      <                 and     #L              ;  %btsf 10H,_BIT0,N
   653                      <                 beq     N               ;  if(10H.0=0) goto N 
   654                      <                .ENDM    
   655                      <       
   656                      <       ;/***********************************************/
