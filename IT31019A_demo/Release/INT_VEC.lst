   290                      <       ;**********************************************************************
   291                      <       ;ROM Checksum
   292                      <       ;**********************************************************************
   293                      <       
   294                      <       D_Bank0UserRomStartAddr:		.EQU	0xE000		;0xE000 ~ 0xFFFF: User ROM Code
   295                      <       
   296                      <       D_Bank0UserRomEndAddr:			.EQU	0xFFF6		;0xFFF7 ~ 0xFFF9 are reserved for Generalplus used
   297                      <       D_NMIandResetVectorStartAddr:	.EQU	0xFFFA		
   298                      <       D_NMIandResetVectorEndAddr:		.EQU	0xFFFF
   299                      <       
   300                      <       
   301                      <       ; ========================================================================================
   302                      <       ; Macro Name	: M_UserRomChecksum
   303                      <       ; Parameters	: None
   304                      <       ; Return Value	: R_ChecksumResult: bit[7:0]
   305                      <       ;				: R_ChecksumResult + 1: bit[15:8]
   306                      <       ;				: R_ChecksumResult + 2: bit[23:16]
   307                      <       ;				: R_ChecksumResult + 3: bit[31:24]
   308                      <       ; Description	: Calculate user ROM area code checksum
   309                      <       ; Destroy		: A, Y
   310                      <       ; Example		: %M_UserRomChecksum	R_ChecksumAddrPtr, R_ChecksumResult
   311                      <       ; ========================================================================================	
   312                      <       %M_UserRomChecksum:	.MACRO	R_ChecksumAddrPtr, R_ChecksumResult
   313                      <       	LDA		#0
   314                      <       	STA		R_ChecksumResult					;Result Byte0
   315                      <       	STA		R_ChecksumResult + 1				;Result Byte1
   316                      <       	STA		R_ChecksumResult + 2				;Result Byte2
   317                      <       	STA		R_ChecksumResult + 3				;Result Byte3
   318                      <       ;=================== Bank 0 ==================================================	
   319                      <       	LDA		#.HIGH.D_Bank0UserRomStartAddr
   320                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   321                      <       	LDA		#.LOW.D_Bank0UserRomStartAddr
   322                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   323                      <       	LDY		#0
   324                      <       L_ChecksumLoop1?
   325                      <       	LDA		#D_WDT_Clear
   326                      <       	STA		P_WDT_Flag_Clear	
   327                      <       	CLC
   328                      <       	LDA		(R_ChecksumAddrPtr),Y
   329                      <       	ADC		R_ChecksumResult					;Result Low Byte
   330                      <       	STA		R_ChecksumResult					;Result Low Byte
   331                      <       	BCC		L_CheckAddress1?
   332                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   333                      <       	BNE		L_CheckAddress1?
   334                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   335                      <       	BNE		L_CheckAddress1?
   336                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   337                      <       		
   338                      <       L_CheckAddress1?:
   339                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   340                      <       	CMP		#.HIGH.D_Bank0UserRomEndAddr		;End High Byte
   341                      <       	BNE		L_IncreaseAdd1?
   342                      <       	
   343                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   344                      <       	CMP		#.LOW.D_Bank0UserRomEndAddr			;End Low Byte
   345                      <       	BEQ		L_ExitRomSum1?
   346                      <       	
   347                      <       L_IncreaseAdd1?:
   348                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   349                      <       	BNE		L_ChecksumLoop1?
   350                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   351                      <       	JMP		L_ChecksumLoop1?	
   352                      <       		
   353                      <       L_ExitRomSum1?:	
   354                      <       ;===================NMI & Reset Vector==================================================		
   355                      <       	LDA		#.HIGH.D_NMIandResetVectorStartAddr
   356                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   357                      <       	LDA		#.LOW.D_NMIandResetVectorStartAddr
   358                      <       	STA		R_ChecksumAddrPtr				;Start Low Byte
   359                      <       		
   360                      <       L_ChecksumLoop2?
   361                      <       	LDA		#D_WDT_Clear
   362                      <       	STA		P_WDT_Flag_Clear
   363                      <       	CLC
   364                      <       	LDA		(R_ChecksumAddrPtr),Y
   365                      <       	ADC		R_ChecksumResult					;Result Low Byte
   366                      <       	STA		R_ChecksumResult					;Result Low Byte
   367                      <       	BCC		L_CheckAddress2?
   368                      <       	INC		R_ChecksumResult + 1				;Result Byte2
   369                      <       	BNE		L_CheckAddress2?
   370                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   371                      <       	BNE		L_CheckAddress2?
   372                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   373                      <       		
   374                      <       L_CheckAddress2?:
   375                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   376                      <       	CMP		#.HIGH.D_NMIandResetVectorEndAddr	;End High Byte
   377                      <       	BNE		L_IncreaseAdd2?
   378                      <       	
   379                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   380                      <       	CMP		#.LOW.D_NMIandResetVectorEndAddr	;End Low Byte
   381                      <       	BEQ		L_EndChecksum?
   382                      <       	
   383                      <       L_IncreaseAdd2?:
   384                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   385                      <       	BNE		L_ChecksumLoop2?
   386                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   387                      <       	JMP		L_ChecksumLoop2?	
   388                      <       	
   389                      <       L_EndChecksum?:
   390                      <       
   391                      <       	.ENDM
   392                      <       
   393                      <       EV_Simualtion		.EQU	0
   394                      <       OTP_BurnIn			.EQU	1
   395                      <       GPL812P01Bx_Mode	.EQU	OTP_BurnIn
   396                      <       
   397                      <       	
   398                      <       			.ENDIF
   399                      <       			.ENDIF
   400                      <       	.ENDIF
