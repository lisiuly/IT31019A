   567                      <       %M_DisAllInt:		.MACRO
   568                      <       
   569                      <       	LDA	#00H
   570                      <       	STA	P_INT_Ctrl0
   571                      <       	LDA	#FFH	
   572                      <       	STA	P_INT_Clear0
   573                      <       	
   574                      <       	LDA	#00H
   575                      <       	STA	P_INT_Ctrl1
   576                      <       	LDA	#FFH
   577                      <       	STA	P_INT_Clear1
   578                      <       
   579                      <       	LDA	#00H
   580                      <       	STA	P_INT_Ctrl2
   581                      <       	LDA	#FFH
   582                      <       	STA	P_INT_Clear2
   583                      <       	
   584                      <       	.ENDM
