   596                      <       ; Macro Name:	%M_InitLCD
   597                      <       ; Description:	Initialize LCD configuration after power on
   598                      <       ;-----------------------------------------------------------------------------	
   599                      <       %M_InitLCD:		.MACRO
   600                      <           LDA		#D_LCDMode_Normal+D_LCDSetting_3Bias_4Duty+D_LCDGreenMode_En
   601                      <       ;	LDA		#(D_LCDMode_Normal+D_LCDSetting_3Bias_4Duty)
   602                      <       	STA		P_LCD_Ctrl		;1/4duty,1/3bias,normal scan
   603                      <       
   604                      <       	.ENDM
   605                      <       ;-----------------------------------------------------------------------------
   606                      <       ; Macro Name:	%FillLcdDpram
   607                      <       ; Description:	Fill LCD DPRAM $50 ~$5F
   608                      <       ;-----------------------------------------------------------------------------
   609                      <       %FillLcdDpram	.MACRO	mData
   610                      <       		
   611                      <       		%M_ClearWatchDog
   612                      <       		LDX		#00H
   613                      <       		LDA     mData
   614                      <       ?L_ClrDpramLoop:
   615                      <       		STA		$50,X
   616                      <       		INX
   617                      <       		CPX		#10H
   618                      <       		BNE		?L_ClrDpramLoop	
   619                      <       
   620                      <       	.ENDM
   621                      <       ;-----------------------------------------------------------------------------
   622                      <       ; Macro Name:	%M_PushAll
   623                      <       ; Description:	Push
   624                      <       ;-----------------------------------------------------------------------------		
   625                      <       %M_PushAll:		.MACRO
   626                      <       		PHP
   627                      <       		PHA
   628                      <       		TXA
   629                      <       		PHA
   630                      <       		TYA
   631                      <       		PHA
   632                      <       			.ENDM
   633                      <       ;-----------------------------------------------------------------------------
   634                      <       ; Macro Name:	%M_PopAll
   635                      <       ; Description:	Pop
   636                      <       ;-----------------------------------------------------------------------------	
   637                      <       %M_PopAll:		.MACRO
   638                      <       		PLA
   639                      <       		TAY
   640                      <       		PLA
   641                      <       		TAX
   642                      <       		PLA
   643                      <       		PLP
   644                      <       			.ENDM	
   645                      <       
   646                      <       ;----------------------------------------------------------
   647                      <       ;/***********************************************/
   648                      <       ;         i.L=1 
   649                      <       %bits:   .MACRO   i,L             ;BYTE i;  
   650                      <                 lda     i               ;ex.  
   651                      <                 ora     #L              ;  %bits 10H,_BIT0  ;  10H.0=1
   652                      <                 sta     i               ;
   653                      <                .ENDM    
   654                      <       
   655                      <       ;/***********************************************/
   656                      <       ;         i.L=0
   657                      <       %bitr:   .MACRO   i,L             ;BYTE i;  
   658                      <                 lda     i               ;ex.  
   659                      <                 and     #.NOT.L         ;  %bitr 10H,_BIT0;  10H.0=0
   660                      <                 sta     i
   661                      <                .ENDM    
   662                      <       
   663                      <       ;/***********************************************/
   664                      <       ;         if(i.L==1) goto N
   665                      <       %btst:   .MACRO   i,L,N           ;BYTE i;  
   666                      <                 lda     i               ;ex.   
   667                      <                 and     #L              ;  %btst 10H,_BIT0,N
   668                      <                 bne     N               ;  if(10H.0=1) goto N 
   669                      <                .ENDM    
   670                      <                                         
   671                      <       ;/***********************************************/
   672                      <       ;         if(i.L==0) goto N
   673                      <       %btsf:   .MACRO   i,L,N           ;BYTE i;    
   674                      <                 lda     i               ;ex.   
   675                      <                 and     #L              ;  %btsf 10H,_BIT0,N
   676                      <                 beq     N               ;  if(10H.0=0) goto N 
   677                      <                .ENDM    
   678                      <       
   679                      <       ;/***********************************************/
   680                      <       %F_IO_Intital:	.macro
   681                      <       		LDA		#00000000b
   682                      <       		STA		P_IO_PortA_Attrib	
   683                      <       		LDA		#00000000b		;PA0~PA7 as lcd segment
   684                      <       		STA		P_IO_PortA_Dir
   685                      <       		LDA		#11111111b
   686                      <       		STA		P_IO_PortA_Data
   687                      <       		
   688                      <       		LDA		#00000000b
   689                      <       		STA		P_IO_PortB_Attrib		
   690                      <       		LDA		#00000000b	
   691                      <       		STA		P_IO_PortB_Dir
   692                      <       		LDA		#00001111b
   693                      <       		STA		P_IO_PortB_Data
   694                      <       		
   695                      <       		LDA		#00000000b
   696                      <       		STA		P_IO_PortC_Attrib		
   697                      <       		LDA		#00000000b	
   698                      <       		STA		P_IO_PortC_Dir
   699                      <       		LDA		#11111111b
   700                      <       		STA		P_IO_PortC_Data	
   701                      <       		
   702                      <       		LDA		#00000000b
   703                      <       		STA		P_IO_PortD_Attrib		
   704                      <       		LDA		#10000000b		;PD2,3,5 as input low,PD7,output LOW
   705                      <       		STA		P_IO_PortD_Dir
   706                      <       		LDA		#00101100b
   707                      <       		STA		P_IO_PortD_Data
   708                      <       .endm
   709                      <       ;/***********************************************/
