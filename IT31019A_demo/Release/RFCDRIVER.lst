   527                      <       ; Macro Name:	%FillSram
   528                      <       ; Description:	Fill data to SRAM $80 ~ $fF
   529                      <       ; Input:		mData
   530                      <       ;==========================================
   531                      <       %RAM_Init:		.MACRO	
   532                      <       		LDy		#0
   533                      <       		LDA		#0	
   534                      <       ?L_FillRAMLOOP:	
   535                      <       		STA		$80,y
   536                      <       		INy
   537                      <       		CPy		#128
   538                      <       		BCC		?L_FillRAMLOOP
   539                      <       .ENDM
   540                      <       
   541                      <       
   542                      <       %RAM2_Init:		.macro
   543                      <       	
   544                      <       		LDX		#00		
   545                      <       		LDA		#00
   546                      <       	?Loop:
   547                      <       		STA		$01C0,x
   548                      <       		INX
   549                      <       		CPX		#64
   550                      <       		BCC		?Loop		
   551                      <       .endm
