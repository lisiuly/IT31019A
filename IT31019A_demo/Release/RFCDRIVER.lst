   263                      <       ;**********************************************************************
   264                      <       ;ROM Checksum
   265                      <       ;**********************************************************************
   266                      <       
   267                      <       D_Bank0UserRomStartAddr:		.EQU	0xE000		;0xE000 ~ 0xFFFF: User ROM Code
   268                      <       
   269                      <       D_Bank0UserRomEndAddr:			.EQU	0xFFF6		;0xFFF7 ~ 0xFFF9 are reserved for Generalplus used
   270                      <       D_NMIandResetVectorStartAddr:	.EQU	0xFFFA		
   271                      <       D_NMIandResetVectorEndAddr:		.EQU	0xFFFF
   272                      <       
   273                      <       
   274                      <       ; ========================================================================================
   275                      <       ; Macro Name	: M_UserRomChecksum
   276                      <       ; Parameters	: None
   277                      <       ; Return Value	: R_ChecksumResult: bit[7:0]
   278                      <       ;				: R_ChecksumResult + 1: bit[15:8]
   279                      <       ;				: R_ChecksumResult + 2: bit[23:16]
   280                      <       ;				: R_ChecksumResult + 3: bit[31:24]
   281                      <       ; Description	: Calculate user ROM area code checksum
   282                      <       ; Destroy		: A, Y
   283                      <       ; Example		: %M_UserRomChecksum	R_ChecksumAddrPtr, R_ChecksumResult
   284                      <       ; ========================================================================================	
   285                      <       %M_UserRomChecksum:	.MACRO	R_ChecksumAddrPtr, R_ChecksumResult
   286                      <       	LDA		#0
   287                      <       	STA		R_ChecksumResult					;Result Byte0
   288                      <       	STA		R_ChecksumResult + 1				;Result Byte1
   289                      <       	STA		R_ChecksumResult + 2				;Result Byte2
   290                      <       	STA		R_ChecksumResult + 3				;Result Byte3
   291                      <       ;=================== Bank 0 ==================================================	
   292                      <       	LDA		#.HIGH.D_Bank0UserRomStartAddr
   293                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   294                      <       	LDA		#.LOW.D_Bank0UserRomStartAddr
   295                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   296                      <       	LDY		#0
   297                      <       L_ChecksumLoop1?
   298                      <       	LDA		#D_WDT_Clear
   299                      <       	STA		P_WDT_Flag_Clear	
   300                      <       	CLC
   301                      <       	LDA		(R_ChecksumAddrPtr),Y
   302                      <       	ADC		R_ChecksumResult					;Result Low Byte
   303                      <       	STA		R_ChecksumResult					;Result Low Byte
   304                      <       	BCC		L_CheckAddress1?
   305                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   306                      <       	BNE		L_CheckAddress1?
   307                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   308                      <       	BNE		L_CheckAddress1?
   309                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   310                      <       		
   311                      <       L_CheckAddress1?:
   312                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   313                      <       	CMP		#.HIGH.D_Bank0UserRomEndAddr		;End High Byte
   314                      <       	BNE		L_IncreaseAdd1?
   315                      <       	
   316                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   317                      <       	CMP		#.LOW.D_Bank0UserRomEndAddr			;End Low Byte
   318                      <       	BEQ		L_ExitRomSum1?
   319                      <       	
   320                      <       L_IncreaseAdd1?:
   321                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   322                      <       	BNE		L_ChecksumLoop1?
   323                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   324                      <       	JMP		L_ChecksumLoop1?	
   325                      <       		
   326                      <       L_ExitRomSum1?:	
   327                      <       ;===================NMI & Reset Vector==================================================		
   328                      <       	LDA		#.HIGH.D_NMIandResetVectorStartAddr
   329                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   330                      <       	LDA		#.LOW.D_NMIandResetVectorStartAddr
   331                      <       	STA		R_ChecksumAddrPtr				;Start Low Byte
   332                      <       		
   333                      <       L_ChecksumLoop2?
   334                      <       	LDA		#D_WDT_Clear
   335                      <       	STA		P_WDT_Flag_Clear
   336                      <       	CLC
   337                      <       	LDA		(R_ChecksumAddrPtr),Y
   338                      <       	ADC		R_ChecksumResult					;Result Low Byte
   339                      <       	STA		R_ChecksumResult					;Result Low Byte
   340                      <       	BCC		L_CheckAddress2?
   341                      <       	INC		R_ChecksumResult + 1				;Result Byte2
   342                      <       	BNE		L_CheckAddress2?
   343                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   344                      <       	BNE		L_CheckAddress2?
   345                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   346                      <       		
   347                      <       L_CheckAddress2?:
   348                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   349                      <       	CMP		#.HIGH.D_NMIandResetVectorEndAddr	;End High Byte
   350                      <       	BNE		L_IncreaseAdd2?
   351                      <       	
   352                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   353                      <       	CMP		#.LOW.D_NMIandResetVectorEndAddr	;End Low Byte
   354                      <       	BEQ		L_EndChecksum?
   355                      <       	
   356                      <       L_IncreaseAdd2?:
   357                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   358                      <       	BNE		L_ChecksumLoop2?
   359                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   360                      <       	JMP		L_ChecksumLoop2?	
   361                      <       	
   362                      <       L_EndChecksum?:
   363                      <       
   364                      <       	.ENDM
