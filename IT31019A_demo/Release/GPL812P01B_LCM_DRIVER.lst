   284                      <       ;**********************************************************************
   285                      <       ;ROM Checksum
   286                      <       ;**********************************************************************
   287                      <       
   288                      <       D_Bank0UserRomStartAddr:		.EQU	0xE000		;0xE000 ~ 0xFFFF: User ROM Code
   289                      <       
   290                      <       D_Bank0UserRomEndAddr:			.EQU	0xFFF6		;0xFFF7 ~ 0xFFF9 are reserved for Generalplus used
   291                      <       D_NMIandResetVectorStartAddr:	.EQU	0xFFFA		
   292                      <       D_NMIandResetVectorEndAddr:		.EQU	0xFFFF
   293                      <       
   294                      <       
   295                      <       ; ========================================================================================
   296                      <       ; Macro Name	: M_UserRomChecksum
   297                      <       ; Parameters	: None
   298                      <       ; Return Value	: R_ChecksumResult: bit[7:0]
   299                      <       ;				: R_ChecksumResult + 1: bit[15:8]
   300                      <       ;				: R_ChecksumResult + 2: bit[23:16]
   301                      <       ;				: R_ChecksumResult + 3: bit[31:24]
   302                      <       ; Description	: Calculate user ROM area code checksum
   303                      <       ; Destroy		: A, Y
   304                      <       ; Example		: %M_UserRomChecksum	R_ChecksumAddrPtr, R_ChecksumResult
   305                      <       ; ========================================================================================	
   306                      <       %M_UserRomChecksum:	.MACRO	R_ChecksumAddrPtr, R_ChecksumResult
   307                      <       	LDA		#0
   308                      <       	STA		R_ChecksumResult					;Result Byte0
   309                      <       	STA		R_ChecksumResult + 1				;Result Byte1
   310                      <       	STA		R_ChecksumResult + 2				;Result Byte2
   311                      <       	STA		R_ChecksumResult + 3				;Result Byte3
   312                      <       ;=================== Bank 0 ==================================================	
   313                      <       	LDA		#.HIGH.D_Bank0UserRomStartAddr
   314                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   315                      <       	LDA		#.LOW.D_Bank0UserRomStartAddr
   316                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   317                      <       	LDY		#0
   318                      <       L_ChecksumLoop1?
   319                      <       	LDA		#D_WDT_Clear
   320                      <       	STA		P_WDT_Flag_Clear	
   321                      <       	CLC
   322                      <       	LDA		(R_ChecksumAddrPtr),Y
   323                      <       	ADC		R_ChecksumResult					;Result Low Byte
   324                      <       	STA		R_ChecksumResult					;Result Low Byte
   325                      <       	BCC		L_CheckAddress1?
   326                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   327                      <       	BNE		L_CheckAddress1?
   328                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   329                      <       	BNE		L_CheckAddress1?
   330                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   331                      <       		
   332                      <       L_CheckAddress1?:
   333                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   334                      <       	CMP		#.HIGH.D_Bank0UserRomEndAddr		;End High Byte
   335                      <       	BNE		L_IncreaseAdd1?
   336                      <       	
   337                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   338                      <       	CMP		#.LOW.D_Bank0UserRomEndAddr			;End Low Byte
   339                      <       	BEQ		L_ExitRomSum1?
   340                      <       	
   341                      <       L_IncreaseAdd1?:
   342                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   343                      <       	BNE		L_ChecksumLoop1?
   344                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   345                      <       	JMP		L_ChecksumLoop1?	
   346                      <       		
   347                      <       L_ExitRomSum1?:	
   348                      <       ;===================NMI & Reset Vector==================================================		
   349                      <       	LDA		#.HIGH.D_NMIandResetVectorStartAddr
   350                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   351                      <       	LDA		#.LOW.D_NMIandResetVectorStartAddr
   352                      <       	STA		R_ChecksumAddrPtr				;Start Low Byte
   353                      <       		
   354                      <       L_ChecksumLoop2?
   355                      <       	LDA		#D_WDT_Clear
   356                      <       	STA		P_WDT_Flag_Clear
   357                      <       	CLC
   358                      <       	LDA		(R_ChecksumAddrPtr),Y
   359                      <       	ADC		R_ChecksumResult					;Result Low Byte
   360                      <       	STA		R_ChecksumResult					;Result Low Byte
   361                      <       	BCC		L_CheckAddress2?
   362                      <       	INC		R_ChecksumResult + 1				;Result Byte2
   363                      <       	BNE		L_CheckAddress2?
   364                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   365                      <       	BNE		L_CheckAddress2?
   366                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   367                      <       		
   368                      <       L_CheckAddress2?:
   369                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   370                      <       	CMP		#.HIGH.D_NMIandResetVectorEndAddr	;End High Byte
   371                      <       	BNE		L_IncreaseAdd2?
   372                      <       	
   373                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   374                      <       	CMP		#.LOW.D_NMIandResetVectorEndAddr	;End Low Byte
   375                      <       	BEQ		L_EndChecksum?
   376                      <       	
   377                      <       L_IncreaseAdd2?:
   378                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   379                      <       	BNE		L_ChecksumLoop2?
   380                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   381                      <       	JMP		L_ChecksumLoop2?	
   382                      <       	
   383                      <       L_EndChecksum?:
   384                      <       
   385                      <       	.ENDM
   386                      <       
   387                      <       EV_Simualtion		.EQU	0
   388                      <       OTP_BurnIn			.EQU	1
   389                      <       GPL812P01Bx_Mode	.EQU	OTP_BurnIn
   390                      <       
   391                      <       	
   392                      <       			.ENDIF
   393                      <       			.ENDIF
   394                      <       	.ENDIF
