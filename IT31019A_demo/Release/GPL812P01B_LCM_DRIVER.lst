   880                              	STA		D_LCM_Port_Data
   881                              	
   882                              	LDA		D_LCM_Port_Dir	;Set Data Pin / CLK pin   is Output Low
   883                              	ORA		#(D_LCM_DataPin+D_LCM_CLKPin)
   884                              	STA		D_LCM_Port_Dir
   885                              	
   886                              	JSR		DelayUS
   887                              	
   888                              	RTS	
