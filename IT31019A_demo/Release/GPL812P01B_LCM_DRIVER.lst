   415                      <       D_LCD_Address			.EQU	0x0050
   416                      <       D_SegNum				.EQU	16				;Max value = 16		,4x16,6x14,8x12
   417                      <       D_ComNum				.EQU	5				;Max value = 8
   418                      <       D_LCDDataSize			.EQU	D_ComNum*2		;LCD RAM Buffer Size
   419                      <       ;---------------------------------------------------------------------------------------------
   420                      <       D_LCD_VLCD					.EQU	D_LCD_VLCDVDD
   421                      <       									;D_LCD_VLCDVDD	
   422                      <       									;D_LCD_VLCD2_5V
   423                      <       									;D_LCD_VLCD2_4V
   424                      <       									;D_LCD_VLCD2_8V
   425                      <       D_LCD_BiasDuty				.EQU	D_LCDSetting_3Bias_5Duty
   426                      <       									;D_LCDSetting_3Bias_5Duty
   427                      <       									;D_LCDSetting_3Bias_6Duty
   428                      <       									;D_LCDSetting_4Bias_8Duty
   429                      <       D_LCD_GreenMode				.EQU	D_LCDGreenMode_En
   430                      <       									;D_LCDGreenMode_Dis
   431                      <       
   432                      <       D_LCD_Setting				.EQU	D_LCD_VLCD+D_LCD_BiasDuty+D_LCD_GreenMode
   433                      <       ; ---------------------- PA0~7=Seg6~13 ----------------------
   434                      <       D_LCD_PortA_Ctrl       .EQU    11111111B    ; 
   435                      <       D_LCD_PortA_COMSEG     .EQU    00000000B    ; PA7~6=Seg13~12
   436                      <       
   437                      <       ; ---------------------- PortBPB0~3=Com0~3 ----------------------
   438                      <       D_LCD_PortB_Ctrl       .EQU    00001111B    ; 
   439                      <       D_LCD_PortB_COMSEG     .EQU    00001111B    ; PB3~0=Com3~0
   440                      <       
   441                      <       ; ---------------------- PortCC0=Seg14 ----------------------
   442                      <       D_LCD_PortC_Ctrl       .EQU    00000011B    ;
   443                      <       D_LCD_PortC_COMSEG     .EQU    00000010B    ; PC1=Com4
   444                      <       
   445                      <       ; ---------------------- PortD---------------------
   446                      <       D_LCD_PortD_Ctrl       .EQU    00000000B    ; PDΪIO
   447                      <       
   448                      <       ;D_LCD_PortA_Ctrl			.EQU	11111111B		;set PA[7:0] as LCD function
   449                      <       ;D_LCD_PortA_COMSEG			.EQU	00000000B		;Set PA[7:6] as segment output
   450                      <       ;D_LCD_PortB_Ctrl			.EQU	00001111B		;Set PB[3:0] as LCD function
   451                      <       ;D_LCD_PortB_COMSEG			.EQU	00000000B		;Set PB[3:0] as segment output
   452                      <       ;D_LCD_PortC_Ctrl			.EQU	11100000B		;Set PortC[7:5] as LCD function
   453                      <       ;D_LCD_PortC_COMSEG			.EQU    11100000B		;Set PC[7:5] as common  output 
   454                      <       ;D_LCD_PortD_Ctrl			.EQU	00000000B		;set PD[3:2] as normal IO	
   455                      <       
   456                      <       .ENDIF
   457                      <         
   458                              ;==================================================================================
   459                              ;LCM Hardware Configuration Define Area
   460                              ;==================================================================================
   461                              D_LCM_Port_Dir		.EQU    P_IO_PortD_Dir
   462                              D_LCM_Port_Attrib	.EQU	P_IO_PortD_Attrib	
   463                              D_LCM_Port_Buffer	.EQU    P_IO_PortD_Buffer
   464                              D_LCM_Port_Data		.EQU	P_IO_PortD_Data	
   465                              
   466                              D_LCM_DataPin		.EQU	0x80	;PD7	PC.7
   467                              D_LCM_CLKPin		.EQU	0x04	;PD2	0x40	;PC.6
   468                              
   469                              ;==================================================================================
   470                              ;LCM Driver Constant Define Area
   471                              ;==================================================================================
   472                              ;LCM Protocol data format is Header(1Byte)+ DataLength(1Byte) + Data(NByte) + CheckSum(1Byte) 
   473                              ;Max. Data Length is 37
   474                              ;register Command format is Register address + Register Data
   475                              ;LCD data Command format is directly fill DPRAM data , DPRAM address is started from 0x50
   476                              
   477                              D_LCM_DataCMD_Header	.EQU		0x80		;Header Command for register data
   478                              D_LCM_LCDCMD_Header		.EQU		0x81		;Header Command for LCD data
   479                              D_LCM_DataOneCMD_Len	.EQU		0x02
   480                              D_LCM_MaxDataLen		.EQU		16			;define max data length ;Max:37
   481                              ;==================================================================================
   482                              ; Function External declare area
   483                              ;==================================================================================
   484                              
   485                              
   486                              ;==================================================================================
   487                              ; Function Public area
   488                              ;==================================================================================
   489                              
   490                              .if	(GPL812P01Bx_Mode=EV_Simualtion)	
   491                              .public		F_LCM_Enable
   492                              .public		F_LCM_Write_OneReg
   493                              .public		F_LCM_Write_NReg
   494                              .public		F_LCM_Write_LCDData
   495                              
   496                              .public		_F_LCM_Enable
   497                              .public		_F_LCM_Write_OneReg
   498                              .public		_F_LCM_Write_NReg
   499                              .public		_F_LCM_Write_LCDData
   500                              
   501                              .endif
   502                              ;==================================================================================
   503                              ; Variable Public area
   504                              ;==================================================================================
   505                              
   506                              .if	(GPL812P01Bx_Mode=EV_Simualtion)
   507                              .public		LCM_Buffer_Ptr
   508                              .public		LCM_Data_Buffer
   509                              .public		R_LCM_DataLength
   510                              .public		R_LCM_Temp
   511                              .public		_LCM_Buffer_Ptr
   512                              .public		_LCM_Data_Buffer
   513                              .public		_R_LCM_DataLength
   514                              .public		_R_LCM_Temp
   515                              .public    R_128Hz_Count
   516                              .public    _R_128Hz_Count
   517                              .endif
   518                              ;==================================================================================
   519                              ; Variable RAM declare area
   520                              ;==================================================================================
   521 000000B9                     LCM_Driver_ZRAM:    .SECTION      .PAGE0
   522                              .if	(GPL812P01Bx_Mode=EV_Simualtion)	
   523                              LCM_Buffer_Ptr		.DS		2					;LCM data buffer address
   524                              _LCM_Buffer_Ptr		.EQU	LCM_Buffer_Ptr	
   525                              .endif
   526                              .ENDS
   527 000000B9                     LCM_Driver_NRAM:    .SECTION
   528                              .if	(GPL812P01Bx_Mode=EV_Simualtion)	
   529                              
   530                              LCM_Data_Buffer			.DS		D_LCM_MaxDataLen+3		;Max Size is acording R_LCM_DataLength+3 
   531                              _LCM_Data_Buffer		.EQU	LCM_Data_Buffer	
   532                              R_LCM_Address			.DS		1				;record LCM Command of register address
   533                              R_LCM_Data				.DS		1				;record LCM Command of register data
   534                              R_LCM_CheckSum			.DS		1				;record LCM Command of check sum
   535                              R_LCM_DataLength		.DS		1				;record LCM Command of DataLength
   536                              _R_LCM_DataLength		.EQU	R_LCM_DataLength
   537                              R_LCM_Temp				.DS		1				;
   538                              _R_LCM_Temp				.EQU	R_LCM_Temp	
   539                              R_128Hz_Count			.DS		1
   540                              _R_128Hz_Count			.EQU	R_128Hz_Count
   541                              .endif
   542                              
   543                              .ENDS
   544                              
   545 0000F0CE                     LCM_Driver_Code:    .SECTION
   546                              .if	(GPL812P01Bx_Mode=EV_Simualtion)
   547                              
   548                              ; =======================================================================================
   549                              ; Function name : F_LCM_Enable
   550                              ; Purpose       : Enable LCM Driver ,Setting Data/CLK pin as Output Low
   551                              ; Parameter     : 
   552                              ; Return        : 
   553                              ; Destroy       : A 
   554                              ; ======================================================================================   	
   555                              F_LCM_Enable:
   556                              _F_LCM_Enable:
   557                              	LDA		D_LCM_Port_Dir
   558                              	AND		#.NOT.(D_LCM_CLKPin+D_LCM_DataPin)
   559                              	STA		D_LCM_Port_Dir
   560                              	;Setting Data/CLK pin as Output Low
   561                              	LDA		D_LCM_Port_Buffer
   562                              	AND		#.NOT.(D_LCM_CLKPin+D_LCM_DataPin)
   563                              	STA		D_LCM_Port_Data
   564                              	
   565                              	LDA		D_LCM_Port_Dir
   566                              	ORA		#(D_LCM_CLKPin+D_LCM_DataPin)
   567                              	STA		D_LCM_Port_Dir
   568                              		
   569                              	LDA		D_LCM_Port_Attrib
   570                              	AND		#.NOT.(D_LCM_CLKPin+D_LCM_DataPin)
   571                              	STA		D_LCM_Port_Attrib
   572                              	
   573                              	LDA		P_INT_Ctrl1
   574                              	ORA		#D_TBH_INT_En
   575                              	STA		P_INT_Ctrl1
   576                              	LDA		#D_TBH_INT_En
   577                              	STA		P_INT_Clear1
   578                              	LDA		#0x00
   579                              	STA		R_128Hz_Count
   580                              	
   581                              	CLI	
   582                              	RTS
   583                              
   584                              ; =======================================================================================
   585                              ; Function name : F_LCM_CMDEnd
   586                              ; Purpose       : LCM Command End 
   587                              ; Parameter     : 
   588                              ; Return        : 
   589                              ; Destroy       : A 
   590                              ; ======================================================================================   	
   591                              F_LCM_CMDEnd:
   592                              _F_LCM_CMDEnd:  
   593                              	JSR		F_LCM_DataLow
   594                              	JSR		F_LCM_ClkLow
   595                              	RTS    
   596                                ; ====================================================================================
   597                              ; Function name : F_LCM_ClkHigh
   598                              ; Purpose       : LCM Clock pin set  High
   599                              ; Parameter     : 
   600                              ; Return        : 
   601                              ; Destroy       : A 
   602                              ; ======================================================================================   	
   603                              F_LCM_ClkHigh:	
   604                              	LDA		#D_LCM_CLKPin
   605                              	ORA		D_LCM_Port_Buffer
   606                              	STA		D_LCM_Port_Data
   607                              	RTS
   608                              	
   609                              ; =======================================================================================
   610                              ; Function name : F_LCM_ClkLow
   611                              ; Purpose       : LCM Clock pin set Low
   612                              ; Parameter     : 
   613                              ; Return        : 
   614                              ; Destroy       : A 
   615                              ; ======================================================================================   	
   616                              F_LCM_ClkLow:	
   617                              	LDA		#.Not.D_LCM_CLKPin
   618                              	AND		D_LCM_Port_Buffer
   619                              	STA		D_LCM_Port_Data
   620                              	RTS
   621                              	
   622                              
   623                              ; =======================================================================================
   624                              ; Function name : F_LCM_DataHigh
   625                              ; Purpose       : LCM Data pin set High
   626                              ; Parameter     : 
   627                              ; Return        : 
   628                              ; Destroy       : A 
   629                              ; ======================================================================================   		
   630                              F_LCM_DataHigh:
   631                              	LDA		#D_LCM_DataPin
   632                              	ORA		D_LCM_Port_Buffer
   633                              	STA		D_LCM_Port_Data
   634                              	RTS
   635                              	
   636                              ; =======================================================================================
   637                              ; Function name : F_LCM_DataLow
   638                              ; Purpose       : LCM Data pin set Low
   639                              ; Parameter     : 
   640                              ; Return        : 
   641                              ; Destroy       : A 
   642                              ; ======================================================================================   			
   643                              F_LCM_DataLow:
   644                              	LDA		#.Not.D_LCM_DataPin
   645                              	AND		D_LCM_Port_Buffer
   646                              	STA		D_LCM_Port_Data
   647                              	RTS	  
   648                              	
   649                                
   650                              ; =======================================================================================
   651                              ; Function name : F_LCM_TX_Data
   652                              ; Purpose       : LCM Tx One Byte
   653                              ; Parameter     : Acc=TX DATA
   654                              ; Return        : 
   655                              ; Destroy       : A,X 
   656                              ; ======================================================================================          
   657                              F_LCM_TX_Data:
   658                              	STA		R_LCM_Temp
   659                              	LDX		#0x08
   660                              L_TxData?:	;;HighByte First
   661                              	NOP		;Delay
   662                              	NOP
   663                              	NOP
   664                              	NOP
   665                              	NOP
   666                              	NOP
   667                              	NOP
   668                              	JSR		F_LCM_ClkLow	
   669                              	CLC
   670                              	ROL		R_LCM_Temp
   671                              	BCC		L_LCM_TxLow?
   672                              L_LCM_TxHigh?:	
   673                              	LDA		#D_LCM_DataPin
   674                              	ORA		D_LCM_Port_Buffer
   675                              	STA		D_LCM_Port_Data
   676                              	JMP		L_CheckNext?
   677                              L_LCM_TxLow?:
   678                              	LDA		#.NOT.D_LCM_DataPin
   679                              	AND		D_LCM_Port_Buffer
   680                              	STA		D_LCM_Port_Data
   681                              L_CheckNext?:
   682                              	JSR		F_LCM_ClkHigh		
   683                              	DEX
   684                              	BNE		L_TxData?
   685                              	JSR		F_LCM_ClkLow
   686                              	
   687                              	RTS		
   688                              ; =======================================================================================
   689                              ; Function name : F_LCM_Write_OneReg
   690                              ; Purpose       : 
   691                              ; Parameter     : A:Address Y:Data
   692                              ; Return        : None ; Check sum = length(=2) + address + data
   693                              ; Destroy       : A,X
   694                              ; ======================================================================================
   695                              F_LCM_Write_OneReg:
   696                              _F_LCM_Write_OneReg:
   697                              	STA		R_LCM_Address
   698                              	STY		R_LCM_Data
   699                              	
   700                              	JSR		F_LCM_WaitReady
   701                              	;Claculate Check Sum : Length + address + Data
   702                              	LDA		#0x02	;Length Fix 2
   703                              	STA		R_LCM_CheckSum
   704                              	CLC
   705                              	LDA		R_LCM_Address	
   706                              	ADC		R_LCM_CheckSum
   707                              	STA		R_LCM_CheckSum
   708                              	CLC
   709                              	LDA		R_LCM_Data
   710                              	ADC		R_LCM_CheckSum
   711                              	STA		R_LCM_CheckSum
   712                              	;------------------------------------------------
   713                              	LDA		#D_LCM_DataCMD_Header
   714                              	JSR		F_LCM_TX_Data
   715                              
   716                              	LDA		#D_LCM_DataOneCMD_Len
   717                              	JSR		F_LCM_TX_Data	
   718                              	
   719                              	LDA		R_LCM_Address
   720                              	JSR		F_LCM_TX_Data
   721                              	LDA		R_LCM_Data
   722                              	JSR		F_LCM_TX_Data
   723                              	LDA		R_LCM_CheckSum
   724                              	JSR		F_LCM_TX_Data
   725                              	
   726                              	
   727                              	JSR		F_LCM_CMDEnd
   728                              	JSR		F_LCM_Delay
   729                              	RTS	
   730                              ; =======================================================================================
   731                              ; Function name : F_LCM_Write_NReg
   732                              ; Purpose       : 
   733                              ; Parameter     : LCM_Buffer_Ptr
   734                              ; Return        : None ; Check sum = R_LCM_DataLength + address1 + data1 + 
   735                              ;                       	          address2 + data2 + ....  + addressN + dataN
   736                              ; Destroy       : A,Y,X
   737                              ; ======================================================================================
   738                              F_LCM_Write_NReg:
   739                              _F_LCM_Write_NReg:
   740                              	JSR		F_LCM_WaitReady
   741                              	;Calculate Check Sum
   742                              	LDA		R_LCM_DataLength	
   743                              	STA		R_LCM_Temp
   744                              	STA		R_LCM_CheckSum		
   745                                  LDY     #0
   746                              L_CalculateCheckSum?:    
   747                              	LDA     (LCM_Buffer_Ptr),Y
   748                              	CLC
   749                              	ADC		R_LCM_CheckSum
   750                              	STA		R_LCM_CheckSum
   751                              	INY
   752                              	CPY		R_LCM_DataLength
   753                              	BCC		L_CalculateCheckSum?
   754                              	;----------------------------
   755                              
   756                              	LDA		#D_LCM_DataCMD_Header
   757                              	JSR		F_LCM_TX_Data		
   758                              	LDA		R_LCM_DataLength
   759                              	JSR		F_LCM_TX_Data
   760                              	
   761                                  LDY     #0	
   762                              L_UpdateRegData?:
   763                              	LDA     (LCM_Buffer_Ptr),Y	
   764                              	JSR		F_LCM_TX_Data
   765                              	INY
   766                              	DEC		R_LCM_DataLength
   767                              	BNE		L_UpdateRegData?
   768                              	
   769                              	LDA		R_LCM_CheckSum
   770                              	JSR		F_LCM_TX_Data	
   771                              	
   772                              	JSR		F_LCM_CMDEnd
   773                              	JSR		F_LCM_Delay
   774                              	RTS	
   775                              	
   776                              	
   777                              ; =======================================================================================
   778                              ; Function name : F_LCM_Write_LCDData
   779                              ; Purpose       : 
   780                              ; Parameter     : LCM_Buffer_Ptr
   781                              ; Return        : None ; Check sum = N + 0x50~(0x50x+N)
   782                              ; Destroy       : A,X,Y 
   783                              ; ======================================================================================
   784                              F_LCM_Write_LCDData:
   785                              _F_LCM_Write_LCDData:
   786                              	JSR		F_LCM_WaitReady
   787                              	
   788                              	LDA		#D_LCDDataSize
   789                              	STA		R_LCM_DataLength
   790                              	STA		R_LCM_CheckSum
   791                                  LDY     #0
   792                              L_CalculateCheckSum?:    
   793                              	LDA     (LCM_Buffer_Ptr),Y
   794                              	CLC
   795                              	ADC		R_LCM_CheckSum
   796                              	STA		R_LCM_CheckSum
   797                              	INY
   798                              	CPY		R_LCM_DataLength
   799                              	BCC		L_CalculateCheckSum?
   800                              	;----------------------------
   801                              	LDA		#D_LCM_LCDCMD_Header
   802                              	JSR		F_LCM_TX_Data	
   803                              	LDA		R_LCM_DataLength
   804                              	JSR		F_LCM_TX_Data
   805                                  LDY     #0	
   806                              L_UpdateAgain?:
   807                              	LDA     (LCM_Buffer_Ptr),Y	
   808                              	JSR		F_LCM_TX_Data
   809                              	INY
   810                              	DEC		R_LCM_DataLength
   811                              	BNE		L_UpdateAgain?
   812                              	
   813                              	LDA		R_LCM_CheckSum
   814                              	JSR		F_LCM_TX_Data
   815                              	
   816                              	JSR		F_LCM_CMDEnd	
   817                              	
   818                              	JSR		F_LCM_Delay
   819                              	RTS	
   820                              
   821                              	
   822                              ; =======================================================================================
   823                              ; Function name : F_LCM_WaitReady
   824                              ; Purpose       : 
   825                              ; Parameter     : 
   826                              ; Return        : None ; 
   827                              ; Destroy       : A 
   828                              ; ======================================================================================
   829                              F_LCM_WaitReady:	
   830                              	
   831                              	LDA		D_LCM_Port_Dir	;Set Data Pin Is Input Low , CLK pin is Output Low
   832                              	AND		#.not.D_LCM_DataPin
   833                              	ORA		#D_LCM_CLKPin
   834                              	STA		D_LCM_Port_Dir
   835                              	
   836                              	LDA		D_LCM_Port_Buffer		
   837                              	AND		#.not.D_LCM_CLKPin
   838                              	STA		D_LCM_Port_Data
   839                              	
   840                              	;---------------------
   841                              
   842                              	LDA		D_LCM_Port_Buffer		
   843                              	ORA		#D_LCM_CLKPin
   844                              	STA		D_LCM_Port_Data	
   845                              	
   846                              	JSR		DelayUS
   847                              	
   848                              	LDA		D_LCM_Port_Buffer		
   849                              	AND		#.not.D_LCM_CLKPin
   850                              	STA		D_LCM_Port_Data	
   851                              	;---------------------
   852                              	LDA		#0x00
   853                              	STA		R_128Hz_Count
   854                              L_Wait_DataPinHigh?	
   855                              	LDA		R_128Hz_Count
   856                              	BNE		F_LCM_WaitReady
   857                              	LDA		#0xAA
   858                              	STA		P_WDT_Flag_Clear
   859                              	
   860                              	LDA		D_LCM_Port_Data
   861                              	AND		#D_LCM_DataPin
   862                              	BEQ		L_Wait_DataPinHigh?
   863                              	
   864                              	JSR		DelayUS
   865                              	
   866                              	LDA		D_LCM_Port_Buffer		;CLK High
   867                              	ORA		#D_LCM_CLKPin
