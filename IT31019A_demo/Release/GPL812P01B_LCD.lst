   463                      <       D_LCD_Address			.EQU	0x0050
   464                      <       D_SegNum				.EQU	16				;Max value = 16		,4x16,6x14,8x12
   465                      <       D_ComNum				.EQU	5				;Max value = 8
   466                      <       D_LCDDataSize			.EQU	D_ComNum*2		;LCD RAM Buffer Size
   467                      <       ;---------------------------------------------------------------------------------------------
   468                      <       D_LCD_VLCD					.EQU	D_LCD_VLCDVDD
   469                      <       									;D_LCD_VLCDVDD	
   470                      <       									;D_LCD_VLCD2_5V
   471                      <       									;D_LCD_VLCD2_4V
   472                      <       									;D_LCD_VLCD2_8V
   473                      <       D_LCD_BiasDuty				.EQU	D_LCDSetting_3Bias_5Duty
   474                      <       									;D_LCDSetting_3Bias_5Duty
   475                      <       									;D_LCDSetting_3Bias_6Duty
   476                      <       									;D_LCDSetting_4Bias_8Duty
   477                      <       D_LCD_GreenMode				.EQU	D_LCDGreenMode_En
   478                      <       									;D_LCDGreenMode_Dis
   479                      <       
   480                      <       D_LCD_Setting				.EQU	D_LCD_VLCD+D_LCD_BiasDuty+D_LCD_GreenMode
   481                      <       ; ---------------------- PA0~7=Seg6~13 ----------------------
   482                      <       D_LCD_PortA_Ctrl       .EQU    11111111B    ; 
   483                      <       D_LCD_PortA_COMSEG     .EQU    00000000B    ; PA7~6=Seg13~12
   484                      <       
   485                      <       ; ---------------------- PortBPB0~3=Com0~3 ----------------------
   486                      <       D_LCD_PortB_Ctrl       .EQU    00001111B    ; 
   487                      <       D_LCD_PortB_COMSEG     .EQU    00001111B    ; PB3~0=Com3~0
   488                      <       
   489                      <       ; ---------------------- PortCC0=Seg14 ----------------------
   490                      <       D_LCD_PortC_Ctrl       .EQU    00000011B    ;
   491                      <       D_LCD_PortC_COMSEG     .EQU    00000010B    ; PC1=Com4
   492                      <       
   493                      <       ; ---------------------- PortD---------------------
   494                      <       D_LCD_PortD_Ctrl       .EQU    00000000B    ; PDΪIO
   495                      <       
   496                      <       ;D_LCD_PortA_Ctrl			.EQU	11111111B		;set PA[7:0] as LCD function
   497                      <       ;D_LCD_PortA_COMSEG			.EQU	00000000B		;Set PA[7:6] as segment output
   498                      <       ;D_LCD_PortB_Ctrl			.EQU	00001111B		;Set PB[3:0] as LCD function
   499                      <       ;D_LCD_PortB_COMSEG			.EQU	00000000B		;Set PB[3:0] as segment output
   500                      <       ;D_LCD_PortC_Ctrl			.EQU	11100000B		;Set PortC[7:5] as LCD function
   501                      <       ;D_LCD_PortC_COMSEG			.EQU    11100000B		;Set PC[7:5] as common  output 
   502                      <       ;D_LCD_PortD_Ctrl			.EQU	00000000B		;set PD[3:2] as normal IO	
   503                      <       
   504                      <       .ENDIF
