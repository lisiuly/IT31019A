   409                      <       ; Function name : F_LCM_Write_OneReg
   410                      <       ; Purpose       : 
   411                      <       ; Parameter     : A:Address Y:Data
   412                      <       ; Return        : None ; Check sum = length(=2) + address + data
   413                      <       ; Destroy       : A,X
   414                      <       ; ======================================================================================
   415                      <       .extern		F_LCM_Write_OneReg
   416                      <       ; =======================================================================================
   417                      <       ; Function name : F_LCM_Write_NReg
