   649                              ; Function name : F_LCD_Close
   650                              ; Purpose       : LCD interface Close
   651                              ; Parameter     : 
   652                              ; Return        : 
   653                              ; Destroy       : A 
   654                              ; ======================================================================================   
   655 0000F0EF                     F_LCD_Close:
   656 0000F0EF                     _F_LCD_Close:
   657                              		.if	(GPL812P01Bx_Mode=EV_Simualtion)
   658                              			LDA		#P_LCD_Ctrl
   659                              			LDY		#D_LCDMode_DisplayOff		
   660                              			JSR		F_LCM_Write_OneReg
   661                              		.ELSE
   662 0000F0EF A9 03               			LDA		#D_LCDMode_DisplayOff
   663 0000F0F1 85 32               			STA		P_LCD_Ctrl
   664                              		.ENDIF
   665 0000F0F3 60                  			RTS	
   666                              ; =======================================================================================
   667                              ; Function name : F_LCD_Clear
   668                              ; Purpose       : Clear LCD DPRAM
   669                              ; Parameter     : A:LCD data
   670                              ; Return        : 
   671                              ; Destroy       : A,Y 
   672                              ; ======================================================================================  
   673 0000F0F4                     F_LCD_Clear:	
   674 0000F0F4                     _F_LCD_Clear:
   675 0000F0F4 AA                  	TAX
   676 0000F0F5 A9 BD               	LDA		#.LOW.LCD_DPRAM_Buffer
   677 0000F0F7 85 B9               	STA		LCD_DPRAM_Ptr	
   678 0000F0F9 A9 00               	LDA		#.high.LCD_DPRAM_Buffer
   679 0000F0FB 85 BA               	STA		LCD_DPRAM_Ptr+1
   680 0000F0FD A0 00               	LDY		#0x00
   681 0000F0FF 8A                  	TXA
   682 0000F100                     L_Clear?:	
   683 0000F100 91 B9               	STA		(LCD_DPRAM_Ptr),Y
   684 0000F102 C8                  	INY
   685 0000F103 C0 0A               	CPY		#D_LCDDataSize		
   686 0000F105 D0 F9               	BNE		L_Clear?
   687 0000F107 20 0B F1            	JSR		F_LCD_PutRAMToDPRAM		
   688                              
   689 0000F10A 60                  	RTS
   690                              
   691                              
   692                              ; =======================================================================================
   693                              ; Function name : F_LCD_PutRAMToDPRAM
   694                              ; Purpose       : Put RAM Buffer to DPRAM(0x50~0x5F)
   695                              ; Parameter     : 
   696                              ; Return        : 
   697                              ; Destroy       : A,X,Y 
   698                              ; ======================================================================================  
   699 0000F10B                     F_LCD_PutRAMToDPRAM:	
   700 0000F10B                     _F_LCD_PutRAMToDPRAM:	
   701                              	.if	(GPL812P01Bx_Mode=EV_Simualtion)
   702                              		LDA		#.LOW.LCD_DPRAM_Buffer
   703                              		STA		LCM_Buffer_Ptr	
   704                              		LDA		#.high.LCD_DPRAM_Buffer
   705                              		STA		LCM_Buffer_Ptr+1
   706                              		JSR		F_LCM_Write_LCDData
   707                              	.else
   708                              ;		LDA		#.LOW.D_LCD_Address
   709                              ;		STA		LCD_DPRAM_Ptr	
   710                              ;		LDA		#.high.D_LCD_Address
   711                              ;		STA		LCD_DPRAM_Ptr+1
   712                              		
   713                              ;		LDA		#.LOW.LCD_DPRAM_Buffer
   714                              ;		STA		LCD_RAM_Ptr	
   715                              ;		LDA		#.high.LCD_DPRAM_Buffer
   716                              ;		STA		LCD_RAM_Ptr+1	
   717                              ;		
   718                              ;		LDY		#0x00
   719                              ;		LDX		#0x00
   720                              ;	L_loop?:	
   721                              ;		LDA		(LCD_RAM_Ptr),Y
   722                              ;		STA		(LCD_DPRAM_Ptr,X)
   723                              ;		INY
   724                              ;		INC		LCD_DPRAM_Ptr
   725                              ;		CPY		#D_LCDDataSize
   726                              ;		BNE		L_loop?
   727                              		.endif	
   728 0000F10B 60                  	RTS	
