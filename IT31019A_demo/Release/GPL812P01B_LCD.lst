   285                      <       ;**********************************************************************
   286                      <       ;ROM Checksum
   287                      <       ;**********************************************************************
   288                      <       
   289                      <       D_Bank0UserRomStartAddr:		.EQU	0xE000		;0xE000 ~ 0xFFFF: User ROM Code
   290                      <       
   291                      <       D_Bank0UserRomEndAddr:			.EQU	0xFFF6		;0xFFF7 ~ 0xFFF9 are reserved for Generalplus used
   292                      <       D_NMIandResetVectorStartAddr:	.EQU	0xFFFA		
   293                      <       D_NMIandResetVectorEndAddr:		.EQU	0xFFFF
   294                      <       
   295                      <       
   296                      <       ; ========================================================================================
   297                      <       ; Macro Name	: M_UserRomChecksum
   298                      <       ; Parameters	: None
   299                      <       ; Return Value	: R_ChecksumResult: bit[7:0]
   300                      <       ;				: R_ChecksumResult + 1: bit[15:8]
   301                      <       ;				: R_ChecksumResult + 2: bit[23:16]
   302                      <       ;				: R_ChecksumResult + 3: bit[31:24]
   303                      <       ; Description	: Calculate user ROM area code checksum
   304                      <       ; Destroy		: A, Y
   305                      <       ; Example		: %M_UserRomChecksum	R_ChecksumAddrPtr, R_ChecksumResult
   306                      <       ; ========================================================================================	
   307                      <       %M_UserRomChecksum:	.MACRO	R_ChecksumAddrPtr, R_ChecksumResult
   308                      <       	LDA		#0
   309                      <       	STA		R_ChecksumResult					;Result Byte0
   310                      <       	STA		R_ChecksumResult + 1				;Result Byte1
   311                      <       	STA		R_ChecksumResult + 2				;Result Byte2
   312                      <       	STA		R_ChecksumResult + 3				;Result Byte3
   313                      <       ;=================== Bank 0 ==================================================	
   314                      <       	LDA		#.HIGH.D_Bank0UserRomStartAddr
   315                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   316                      <       	LDA		#.LOW.D_Bank0UserRomStartAddr
   317                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   318                      <       	LDY		#0
   319                      <       L_ChecksumLoop1?
   320                      <       	LDA		#D_WDT_Clear
   321                      <       	STA		P_WDT_Flag_Clear	
   322                      <       	CLC
   323                      <       	LDA		(R_ChecksumAddrPtr),Y
   324                      <       	ADC		R_ChecksumResult					;Result Low Byte
   325                      <       	STA		R_ChecksumResult					;Result Low Byte
   326                      <       	BCC		L_CheckAddress1?
   327                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   328                      <       	BNE		L_CheckAddress1?
   329                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   330                      <       	BNE		L_CheckAddress1?
   331                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   332                      <       		
   333                      <       L_CheckAddress1?:
   334                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   335                      <       	CMP		#.HIGH.D_Bank0UserRomEndAddr		;End High Byte
   336                      <       	BNE		L_IncreaseAdd1?
   337                      <       	
   338                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   339                      <       	CMP		#.LOW.D_Bank0UserRomEndAddr			;End Low Byte
   340                      <       	BEQ		L_ExitRomSum1?
   341                      <       	
   342                      <       L_IncreaseAdd1?:
   343                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   344                      <       	BNE		L_ChecksumLoop1?
   345                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   346                      <       	JMP		L_ChecksumLoop1?	
   347                      <       		
   348                      <       L_ExitRomSum1?:	
   349                      <       ;===================NMI & Reset Vector==================================================		
   350                      <       	LDA		#.HIGH.D_NMIandResetVectorStartAddr
   351                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   352                      <       	LDA		#.LOW.D_NMIandResetVectorStartAddr
   353                      <       	STA		R_ChecksumAddrPtr				;Start Low Byte
   354                      <       		
   355                      <       L_ChecksumLoop2?
   356                      <       	LDA		#D_WDT_Clear
   357                      <       	STA		P_WDT_Flag_Clear
   358                      <       	CLC
   359                      <       	LDA		(R_ChecksumAddrPtr),Y
   360                      <       	ADC		R_ChecksumResult					;Result Low Byte
   361                      <       	STA		R_ChecksumResult					;Result Low Byte
   362                      <       	BCC		L_CheckAddress2?
   363                      <       	INC		R_ChecksumResult + 1				;Result Byte2
   364                      <       	BNE		L_CheckAddress2?
   365                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   366                      <       	BNE		L_CheckAddress2?
   367                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   368                      <       		
   369                      <       L_CheckAddress2?:
   370                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   371                      <       	CMP		#.HIGH.D_NMIandResetVectorEndAddr	;End High Byte
   372                      <       	BNE		L_IncreaseAdd2?
   373                      <       	
   374                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   375                      <       	CMP		#.LOW.D_NMIandResetVectorEndAddr	;End Low Byte
   376                      <       	BEQ		L_EndChecksum?
   377                      <       	
   378                      <       L_IncreaseAdd2?:
   379                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   380                      <       	BNE		L_ChecksumLoop2?
   381                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   382                      <       	JMP		L_ChecksumLoop2?	
   383                      <       	
   384                      <       L_EndChecksum?:
   385                      <       
   386                      <       	.ENDM
   387                      <       
   388                      <       EV_Simualtion		.EQU	0
   389                      <       OTP_BurnIn			.EQU	1
   390                      <       GPL812P01Bx_Mode	.EQU	OTP_BurnIn
   391                      <       
   392                      <       	
   393                      <       			.ENDIF
   394                      <       			.ENDIF
   395                      <       	.ENDIF
