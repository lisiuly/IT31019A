   546 0000F0CE                     LCD_Code:    .SECTION
   547                              
   548                              
   549                              ; =======================================================================================
   550                              ; Function name : F_LCD_Intital
   551                              ; Purpose       : VLCD=VDD ,1/3 bias , 1/4 Duty 
   552                              ;				PB[3:0] as segment output
   553                              ;				PC[7:5] as common  output
   554                              ;				PB[6:0] as segment output
   555                              ; Parameter     : 
   556                              ; Return        : 
   557                              ; Destroy       : A,X,Y 
   558                              ; ======================================================================================  
   559 0000F0CE                     F_LCD_Intital:
   560 0000F0CE                     _F_LCD_Intital:
   561                              		.if	(GPL812P01Bx_Mode=EV_Simualtion)
   562                              			LDA		#P_LCD_Ctrl		;Register
   563                              			LDY		#D_LCD_Setting						
   564                              			JSR		F_LCM_Write_OneReg		;P_LCD_Ctrl=#D_LCD_Setting
   565                              			;--------------------------------------------------------------	
   566                              			LDA		#.LOW.LCM_Data_Buffer
   567                              			STA		LCM_Buffer_Ptr	
   568                              			LDA		#.high.LCM_Data_Buffer
   569                              			STA		LCM_Buffer_Ptr+1
   570                              			LDY		#0x00			
   571                              			;------------------------------------------
   572                              			LDA		#P_IOB_LCDPORT_Ctrl
   573                              			STA		(LCM_Buffer_Ptr),Y
   574                              			INY			
   575                              			LDA		#D_LCD_PortB_Ctrl
   576                              			STA		(LCM_Buffer_Ptr),Y
   577                              			INY			
   578                              			;-------------------------------------------------
   579                              			LDA		#P_IOB_SEGCOM_Ctrl	
   580                              			STA		(LCM_Buffer_Ptr),Y
   581                              			INY			
   582                              			LDA		#D_LCD_PortB_COMSEG
   583                              			STA		(LCM_Buffer_Ptr),Y
   584                              			INY
   585                              			;--------------------------------------------------------------			
   586                              			LDA		#P_IOC_LCDPORT_Ctrl	
   587                              			STA		(LCM_Buffer_Ptr),Y
   588                              			INY			
   589                              			LDA		#D_LCD_PortC_Ctrl
   590                              			STA		(LCM_Buffer_Ptr),Y			
   591                              			INY	
   592                              			LDA		#P_IOC_SEGCOM_Ctrl	
   593                              			STA		(LCM_Buffer_Ptr),Y
   594                              			INY			
   595                              			LDA		#D_LCD_PortC_COMSEG
   596                              			STA		(LCM_Buffer_Ptr),Y	
   597                              			INY
   598                              			;-------------------------------------------------
   599                              			LDA		#P_IOA_LCDPORT_Ctrl
   600                              			STA		(LCM_Buffer_Ptr),Y
   601                              			INY			
   602                              			LDA		#D_LCD_PortA_Ctrl
   603                              			STA		(LCM_Buffer_Ptr),Y
   604                              			INY			
   605                              			;-------------------------------------------------			
   606                              			LDA		#P_IOA_SEGCOM_Ctrl
   607                              			STA		(LCM_Buffer_Ptr),Y
   608                              			INY			
   609                              			LDA		#D_LCD_PortA_COMSEG
   610                              			STA		(LCM_Buffer_Ptr),Y
   611                              			INY			
   612                              			;-------------------------------------------------
   613                              			LDA		#P_IOD_LCDPORT_Ctrl
   614                              			STA		(LCM_Buffer_Ptr),Y
   615                              			INY			
   616                              			LDA		#D_LCD_PortD_Ctrl
   617                              			STA		(LCM_Buffer_Ptr),Y
   618                              			INY			
   619                              			;-------------------------------------------------			
   620                              			TYA
   621                              			STA		R_LCM_DataLength		
   622                              			JSR		F_LCM_Write_NReg	;address:LCM_Data_Buffer	
   623                              	.else
   624                              			
   625 0000F0CE A9 E4               		LDA		#D_LCD_Setting
   626 0000F0D0 85 32               		STA		P_LCD_Ctrl
   627                              		
   628 0000F0D2 A9 0F               		LDA		#D_LCD_PortB_Ctrl
   629 0000F0D4 85 4B               		STA		P_IOB_LCDPORT_Ctrl
   630 0000F0D6 A9 0F               		LDA		#D_LCD_PortB_COMSEG
   631 0000F0D8 85 49               		STA		P_IOB_SEGCOM_Ctrl
   632                              		
   633 0000F0DA A9 03               		LDA		#D_LCD_PortC_Ctrl
   634 0000F0DC 85 4C               		STA		P_IOC_LCDPORT_Ctrl
   635 0000F0DE A9 02               		LDA		#D_LCD_PortC_COMSEG
   636 0000F0E0 85 34               		STA		P_IOC_SEGCOM_Ctrl
   637                              		
   638 0000F0E2 A9 FF               		LDA		#D_LCD_PortA_Ctrl
   639 0000F0E4 85 4A               		STA		P_IOA_LCDPORT_Ctrl
   640 0000F0E6 A9 00               		LDA		#D_LCD_PortA_COMSEG
   641 0000F0E8 85 48               		STA		P_IOA_SEGCOM_Ctrl
   642                              
   643 0000F0EA A9 00               		LDA		#D_LCD_PortD_Ctrl
   644 0000F0EC 85 35               		STA		P_IOD_LCDPORT_Ctrl		
   645                              	.endif	
   646 0000F0EE 60                  			RTS	
