   419                      <       ; Parameter     : LCM_Buffer_Ptr
   420                      <       ; Return        : None ; Check sum = R_LCM_DataLength + address1 + data1 + 
   421                      <       ;                       	          address2 + data2 + ....  + addressN + dataN
   422                      <       ; Destroy       : A,Y,X
   423                      <       ; ======================================================================================
   424                      <       .extern		F_LCM_Write_NReg
   425                      <       ; =======================================================================================
   426                      <       ; Function name : F_LCM_Write_LCDData
   427                      <       ; Purpose       : 
   428                      <       ; Parameter     : LCM_Buffer_Ptr
   429                      <       ; Return        : None ; Check sum = N + (0x50~0x50+N)
   430                      <       ; Destroy       : A,X,Y 
