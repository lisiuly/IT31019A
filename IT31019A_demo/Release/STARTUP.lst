   395                      <       OTP_BurnIn			.EQU	1
   396                      <       GPL812P01Bx_Mode	.EQU	OTP_BurnIn
   397                      <       
   398                      <       	
   399                      <       			.ENDIF
   400                      <       			.ENDIF
