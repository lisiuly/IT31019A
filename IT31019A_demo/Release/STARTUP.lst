   640                      <       ;----------------------------------------------------------
   641                      <       ;/***********************************************/
   642                      <       ;         i.L=1 
   643                      <       %bits:   .MACRO   i,L             ;BYTE i;  
   644                      <                 lda     i               ;ex.  
   645                      <                 ora     #L              ;  %bits 10H,_BIT0  ;  10H.0=1
   646                      <                 sta     i               ;
   647                      <                .ENDM    
   648                      <       
   649                      <       ;/***********************************************/
   650                      <       ;         i.L=0
   651                      <       %bitr:   .MACRO   i,L             ;BYTE i;  
   652                      <                 lda     i               ;ex.  
   653                      <                 and     #.NOT.L         ;  %bitr 10H,_BIT0;  10H.0=0
   654                      <                 sta     i
   655                      <                .ENDM    
   656                      <       
   657                      <       ;/***********************************************/
   658                      <       ;         if(i.L==1) goto N
   659                      <       %btst:   .MACRO   i,L,N           ;BYTE i;  
   660                      <                 lda     i               ;ex.   
   661                      <                 and     #L              ;  %btst 10H,_BIT0,N
   662                      <                 bne     N               ;  if(10H.0=1) goto N 
   663                      <                .ENDM    
   664                      <                                         
   665                      <       ;/***********************************************/
   666                      <       ;         if(i.L==0) goto N
   667                      <       %btsf:   .MACRO   i,L,N           ;BYTE i;    
   668                      <                 lda     i               ;ex.   
   669                      <                 and     #L              ;  %btsf 10H,_BIT0,N
   670                      <                 beq     N               ;  if(10H.0=0) goto N 
   671                      <                .ENDM    
   672                      <       
   673                      <       ;/***********************************************/
   674                      <       %F_IO_Intital:	.macro
   675                      <       		LDA		#00000000b
   676                      <       		STA		P_IO_PortA_Attrib	
   677                      <       		LDA		#00000000b		;PA0~PA7 as lcd segment
   678                      <       		STA		P_IO_PortA_Dir
   679                      <       		LDA		#11111111b
   680                      <       		STA		P_IO_PortA_Data
   681                      <       		
   682                      <       		LDA		#00000000b
   683                      <       		STA		P_IO_PortB_Attrib		
   684                      <       		LDA		#00000000b	
   685                      <       		STA		P_IO_PortB_Dir
   686                      <       		LDA		#00001111b
   687                      <       		STA		P_IO_PortB_Data
   688                      <       		
   689                      <       		LDA		#00000000b
   690                      <       		STA		P_IO_PortC_Attrib		
   691                      <       		LDA		#00000000b	
   692                      <       		STA		P_IO_PortC_Dir
   693                      <       		LDA		#11111111b
   694                      <       		STA		P_IO_PortC_Data	
   695                      <       		
   696                      <       		LDA		#00000000b
   697                      <       		STA		P_IO_PortD_Attrib		
   698                      <       		LDA		#10000000b		;PD2,3,5 as input low,PD7,output LOW
   699                      <       		STA		P_IO_PortD_Dir
   700                      <       		LDA		#00101100b
   701                      <       		STA		P_IO_PortD_Data
   702                      <       .endm
   703                      <       ;/***********************************************/
   704                      <       %F_INT_Intital:	.macro
