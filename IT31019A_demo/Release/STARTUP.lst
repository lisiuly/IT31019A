   291                      <       ;**********************************************************************
   292                      <       ;ROM Checksum
   293                      <       ;**********************************************************************
   294                      <       
   295                      <       D_Bank0UserRomStartAddr:		.EQU	0xE000		;0xE000 ~ 0xFFFF: User ROM Code
   296                      <       
   297                      <       D_Bank0UserRomEndAddr:			.EQU	0xFFF6		;0xFFF7 ~ 0xFFF9 are reserved for Generalplus used
   298                      <       D_NMIandResetVectorStartAddr:	.EQU	0xFFFA		
   299                      <       D_NMIandResetVectorEndAddr:		.EQU	0xFFFF
   300                      <       
   301                      <       
   302                      <       ; ========================================================================================
   303                      <       ; Macro Name	: M_UserRomChecksum
   304                      <       ; Parameters	: None
   305                      <       ; Return Value	: R_ChecksumResult: bit[7:0]
   306                      <       ;				: R_ChecksumResult + 1: bit[15:8]
   307                      <       ;				: R_ChecksumResult + 2: bit[23:16]
   308                      <       ;				: R_ChecksumResult + 3: bit[31:24]
   309                      <       ; Description	: Calculate user ROM area code checksum
   310                      <       ; Destroy		: A, Y
   311                      <       ; Example		: %M_UserRomChecksum	R_ChecksumAddrPtr, R_ChecksumResult
   312                      <       ; ========================================================================================	
   313                      <       %M_UserRomChecksum:	.MACRO	R_ChecksumAddrPtr, R_ChecksumResult
   314                      <       	LDA		#0
   315                      <       	STA		R_ChecksumResult					;Result Byte0
   316                      <       	STA		R_ChecksumResult + 1				;Result Byte1
   317                      <       	STA		R_ChecksumResult + 2				;Result Byte2
   318                      <       	STA		R_ChecksumResult + 3				;Result Byte3
   319                      <       ;=================== Bank 0 ==================================================	
   320                      <       	LDA		#.HIGH.D_Bank0UserRomStartAddr
   321                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   322                      <       	LDA		#.LOW.D_Bank0UserRomStartAddr
   323                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   324                      <       	LDY		#0
   325                      <       L_ChecksumLoop1?
   326                      <       	LDA		#D_WDT_Clear
   327                      <       	STA		P_WDT_Flag_Clear	
   328                      <       	CLC
   329                      <       	LDA		(R_ChecksumAddrPtr),Y
   330                      <       	ADC		R_ChecksumResult					;Result Low Byte
   331                      <       	STA		R_ChecksumResult					;Result Low Byte
   332                      <       	BCC		L_CheckAddress1?
   333                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   334                      <       	BNE		L_CheckAddress1?
   335                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   336                      <       	BNE		L_CheckAddress1?
   337                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   338                      <       		
   339                      <       L_CheckAddress1?:
   340                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   341                      <       	CMP		#.HIGH.D_Bank0UserRomEndAddr		;End High Byte
   342                      <       	BNE		L_IncreaseAdd1?
   343                      <       	
   344                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   345                      <       	CMP		#.LOW.D_Bank0UserRomEndAddr			;End Low Byte
   346                      <       	BEQ		L_ExitRomSum1?
   347                      <       	
   348                      <       L_IncreaseAdd1?:
   349                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   350                      <       	BNE		L_ChecksumLoop1?
   351                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   352                      <       	JMP		L_ChecksumLoop1?	
   353                      <       		
   354                      <       L_ExitRomSum1?:	
   355                      <       ;===================NMI & Reset Vector==================================================		
   356                      <       	LDA		#.HIGH.D_NMIandResetVectorStartAddr
   357                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   358                      <       	LDA		#.LOW.D_NMIandResetVectorStartAddr
   359                      <       	STA		R_ChecksumAddrPtr				;Start Low Byte
   360                      <       		
   361                      <       L_ChecksumLoop2?
   362                      <       	LDA		#D_WDT_Clear
   363                      <       	STA		P_WDT_Flag_Clear
   364                      <       	CLC
   365                      <       	LDA		(R_ChecksumAddrPtr),Y
   366                      <       	ADC		R_ChecksumResult					;Result Low Byte
   367                      <       	STA		R_ChecksumResult					;Result Low Byte
   368                      <       	BCC		L_CheckAddress2?
   369                      <       	INC		R_ChecksumResult + 1				;Result Byte2
   370                      <       	BNE		L_CheckAddress2?
   371                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   372                      <       	BNE		L_CheckAddress2?
   373                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   374                      <       		
   375                      <       L_CheckAddress2?:
   376                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   377                      <       	CMP		#.HIGH.D_NMIandResetVectorEndAddr	;End High Byte
   378                      <       	BNE		L_IncreaseAdd2?
   379                      <       	
   380                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   381                      <       	CMP		#.LOW.D_NMIandResetVectorEndAddr	;End Low Byte
   382                      <       	BEQ		L_EndChecksum?
   383                      <       	
   384                      <       L_IncreaseAdd2?:
   385                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   386                      <       	BNE		L_ChecksumLoop2?
   387                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   388                      <       	JMP		L_ChecksumLoop2?	
   389                      <       	
   390                      <       L_EndChecksum?:
   391                      <       
   392                      <       	.ENDM
