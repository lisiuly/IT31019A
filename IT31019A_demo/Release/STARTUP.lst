   564                      <       	STA	P_INT_Ctrl0
   565                      <       	LDA	#FFH	
   566                      <       	STA	P_INT_Clear0
   567                      <       	
   568                      <       	LDA	#00H
   569                      <       	STA	P_INT_Ctrl1
   570                      <       	LDA	#FFH
   571                      <       	STA	P_INT_Clear1
   572                      <       
   573                      <       	LDA	#00H
   574                      <       	STA	P_INT_Ctrl2
