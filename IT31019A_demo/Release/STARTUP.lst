   521                      <       ; Macro Name:	%FillSram
   522                      <       ; Description:	Fill data to SRAM $80 ~ $fF
   523                      <       ; Input:		mData
   524                      <       ;==========================================
   525                      <       %RAM_Init:		.MACRO	
   526                      <       		LDy		#0
   527                      <       		LDA		#0	
   528                      <       ?L_FillRAMLOOP:	
   529                      <       		STA		$80,y
   530                      <       		INy
   531                      <       		CPy		#128
   532                      <       		BCC		?L_FillRAMLOOP
   533                      <       .ENDM
   534                      <       
   535                      <       
   536                      <       %RAM2_Init:		.macro
   537                      <       	
   538                      <       		LDX		#00		
   539                      <       		LDA		#00
   540                      <       	?Loop:
   541                      <       		STA		$01C0,x
   542                      <       		INX
   543                      <       		CPX		#64
   544                      <       		BCC		?Loop		
   545                      <       .endm
