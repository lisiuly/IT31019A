   593                      <       %M_InitLCD:		.MACRO
   594                      <           LDA		#D_LCDMode_Normal+D_LCDSetting_3Bias_4Duty+D_LCDGreenMode_En
   595                      <       ;	LDA		#(D_LCDMode_Normal+D_LCDSetting_3Bias_4Duty)
