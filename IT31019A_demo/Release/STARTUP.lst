   717                      <       
   718                      <       ;		LDA	#D_TM0O_INT_En
   719                      <       ;		LDA		#00
   720                      <       ;		STA P_INT_Ctrl0
   721                      <       		
   722                      <       ;		LDA	#(D_TM0En+D_TM0FoscDiv4)
   723                      <       ;		STA	P_TIMER_Timer0_Ctrl
