   600                      <       ; Macro Name:	%FillLcdDpram
   601                      <       ; Description:	Fill LCD DPRAM $50 ~$5F
   602                      <       ;-----------------------------------------------------------------------------
   603                      <       %FillLcdDpram	.MACRO	mData
   604                      <       		
   605                      <       		%M_ClearWatchDog
   606                      <       		LDX		#00H
   607                      <       		LDA     mData
   608                      <       ?L_ClrDpramLoop:
   609                      <       		STA		$50,X
   610                      <       		INX
   611                      <       		CPX		#10H
   612                      <       		BNE		?L_ClrDpramLoop	
   613                      <       
   614                      <       	.ENDM
