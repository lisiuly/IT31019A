   618                      <       ;-----------------------------------------------------------------------------		
   619                      <       %M_PushAll:		.MACRO
   620                      <       		PHP
   621                      <       		PHA
   622                      <       		TXA
   623                      <       		PHA
   624                      <       		TYA
   625                      <       		PHA
   626                      <       			.ENDM
   627                      <       ;-----------------------------------------------------------------------------
   628                      <       ; Macro Name:	%M_PopAll
   629                      <       ; Description:	Pop
   630                      <       ;-----------------------------------------------------------------------------	
   631                      <       %M_PopAll:		.MACRO
   632                      <       		PLA
   633                      <       		TAY
   634                      <       		PLA
   635                      <       		TAX
   636                      <       		PLA
   637                      <       		PLP
   638                      <       			.ENDM	
