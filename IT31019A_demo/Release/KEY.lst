   627                      <       ;----------------------------------------------------------
   628                      <       ;/***********************************************/
   629                      <       ;         i.L=1 
   630                      <       %bits:   .MACRO   i,L             ;BYTE i;  
   631                      <                 lda     i               ;ex.  
   632                      <                 ora     #L              ;  %bits 10H,_BIT0  ;  10H.0=1
   633                      <                 sta     i               ;
   634                      <                .ENDM    
   635                      <       
   636                      <       ;/***********************************************/
   637                      <       ;         i.L=0
   638                      <       %bitr:   .MACRO   i,L             ;BYTE i;  
   639                      <                 lda     i               ;ex.  
   640                      <                 and     #.NOT.L         ;  %bitr 10H,_BIT0;  10H.0=0
   641                      <                 sta     i
   642                      <                .ENDM    
   643                      <       
   644                      <       ;/***********************************************/
   645                      <       ;         if(i.L==1) goto N
   646                      <       %btst:   .MACRO   i,L,N           ;BYTE i;  
   647                      <                 lda     i               ;ex.   
   648                      <                 and     #L              ;  %btst 10H,_BIT0,N
   649                      <                 bne     N               ;  if(10H.0=1) goto N 
   650                      <                .ENDM    
   651                      <                                         
   652                      <       ;/***********************************************/
   653                      <       ;         if(i.L==0) goto N
   654                      <       %btsf:   .MACRO   i,L,N           ;BYTE i;    
   655                      <                 lda     i               ;ex.   
   656                      <                 and     #L              ;  %btsf 10H,_BIT0,N
   657                      <                 beq     N               ;  if(10H.0=0) goto N 
   658                      <                .ENDM    
   659                      <       
   660                      <       ;/***********************************************/
   661                      <       %F_IO_Intital:	.macro
   662                      <       		LDA		#00000000b
   663                      <       		STA		P_IO_PortA_Attrib	
   664                      <       		LDA		#00000000b		;PA0~PA7 as lcd segment
   665                      <       		STA		P_IO_PortA_Dir
   666                      <       		LDA		#11111111b
   667                      <       		STA		P_IO_PortA_Data
   668                      <       		
   669                      <       		LDA		#00000000b
   670                      <       		STA		P_IO_PortB_Attrib		
   671                      <       		LDA		#00000000b	
   672                      <       		STA		P_IO_PortB_Dir
   673                      <       		LDA		#00001111b
   674                      <       		STA		P_IO_PortB_Data
   675                      <       		
   676                      <       		LDA		#00000000b
   677                      <       		STA		P_IO_PortC_Attrib		
   678                      <       		LDA		#00000000b	
   679                      <       		STA		P_IO_PortC_Dir
   680                      <       		LDA		#11111111b
   681                      <       		STA		P_IO_PortC_Data	
   682                      <       		
   683                      <       		LDA		#00000000b
   684                      <       		STA		P_IO_PortD_Attrib		
   685                      <       		LDA		#10000000b		;PD2,3,5 as input low,PD7,output LOW
   686                      <       		STA		P_IO_PortD_Dir
   687                      <       		LDA		#00101100b
   688                      <       		STA		P_IO_PortD_Data
   689                      <       .endm
   690                      <       ;/***********************************************/
