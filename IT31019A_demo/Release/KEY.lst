   265                      <       ;**********************************************************************
   266                      <       ;ROM Checksum
   267                      <       ;**********************************************************************
   268                      <       
   269                      <       D_Bank0UserRomStartAddr:		.EQU	0xE000		;0xE000 ~ 0xFFFF: User ROM Code
   270                      <       
   271                      <       D_Bank0UserRomEndAddr:			.EQU	0xFFF6		;0xFFF7 ~ 0xFFF9 are reserved for Generalplus used
   272                      <       D_NMIandResetVectorStartAddr:	.EQU	0xFFFA		
   273                      <       D_NMIandResetVectorEndAddr:		.EQU	0xFFFF
   274                      <       
   275                      <       
   276                      <       ; ========================================================================================
   277                      <       ; Macro Name	: M_UserRomChecksum
   278                      <       ; Parameters	: None
   279                      <       ; Return Value	: R_ChecksumResult: bit[7:0]
   280                      <       ;				: R_ChecksumResult + 1: bit[15:8]
   281                      <       ;				: R_ChecksumResult + 2: bit[23:16]
   282                      <       ;				: R_ChecksumResult + 3: bit[31:24]
   283                      <       ; Description	: Calculate user ROM area code checksum
   284                      <       ; Destroy		: A, Y
   285                      <       ; Example		: %M_UserRomChecksum	R_ChecksumAddrPtr, R_ChecksumResult
   286                      <       ; ========================================================================================	
   287                      <       %M_UserRomChecksum:	.MACRO	R_ChecksumAddrPtr, R_ChecksumResult
   288                      <       	LDA		#0
   289                      <       	STA		R_ChecksumResult					;Result Byte0
   290                      <       	STA		R_ChecksumResult + 1				;Result Byte1
   291                      <       	STA		R_ChecksumResult + 2				;Result Byte2
   292                      <       	STA		R_ChecksumResult + 3				;Result Byte3
   293                      <       ;=================== Bank 0 ==================================================	
   294                      <       	LDA		#.HIGH.D_Bank0UserRomStartAddr
   295                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   296                      <       	LDA		#.LOW.D_Bank0UserRomStartAddr
   297                      <       	STA		R_ChecksumAddrPtr					;Start Low Byte
   298                      <       	LDY		#0
   299                      <       L_ChecksumLoop1?
   300                      <       	LDA		#D_WDT_Clear
   301                      <       	STA		P_WDT_Flag_Clear	
   302                      <       	CLC
   303                      <       	LDA		(R_ChecksumAddrPtr),Y
   304                      <       	ADC		R_ChecksumResult					;Result Low Byte
   305                      <       	STA		R_ChecksumResult					;Result Low Byte
   306                      <       	BCC		L_CheckAddress1?
   307                      <       	INC		R_ChecksumResult + 1				;Result Byte1
   308                      <       	BNE		L_CheckAddress1?
   309                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   310                      <       	BNE		L_CheckAddress1?
   311                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   312                      <       		
   313                      <       L_CheckAddress1?:
   314                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   315                      <       	CMP		#.HIGH.D_Bank0UserRomEndAddr		;End High Byte
   316                      <       	BNE		L_IncreaseAdd1?
   317                      <       	
   318                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   319                      <       	CMP		#.LOW.D_Bank0UserRomEndAddr			;End Low Byte
   320                      <       	BEQ		L_ExitRomSum1?
   321                      <       	
   322                      <       L_IncreaseAdd1?:
   323                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   324                      <       	BNE		L_ChecksumLoop1?
   325                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   326                      <       	JMP		L_ChecksumLoop1?	
   327                      <       		
   328                      <       L_ExitRomSum1?:	
   329                      <       ;===================NMI & Reset Vector==================================================		
   330                      <       	LDA		#.HIGH.D_NMIandResetVectorStartAddr
   331                      <       	STA		R_ChecksumAddrPtr + 1				; Start High Byte
   332                      <       	LDA		#.LOW.D_NMIandResetVectorStartAddr
   333                      <       	STA		R_ChecksumAddrPtr				;Start Low Byte
   334                      <       		
   335                      <       L_ChecksumLoop2?
   336                      <       	LDA		#D_WDT_Clear
   337                      <       	STA		P_WDT_Flag_Clear
   338                      <       	CLC
   339                      <       	LDA		(R_ChecksumAddrPtr),Y
   340                      <       	ADC		R_ChecksumResult					;Result Low Byte
   341                      <       	STA		R_ChecksumResult					;Result Low Byte
   342                      <       	BCC		L_CheckAddress2?
   343                      <       	INC		R_ChecksumResult + 1				;Result Byte2
   344                      <       	BNE		L_CheckAddress2?
   345                      <       	INC		R_ChecksumResult + 2				;Result Byte3
   346                      <       	BNE		L_CheckAddress2?
   347                      <       	INC		R_ChecksumResult + 3				;Result Byte4
   348                      <       		
   349                      <       L_CheckAddress2?:
   350                      <       	LDA		R_ChecksumAddrPtr + 1				;Address Pointer HB
   351                      <       	CMP		#.HIGH.D_NMIandResetVectorEndAddr	;End High Byte
   352                      <       	BNE		L_IncreaseAdd2?
   353                      <       	
   354                      <       	LDA		R_ChecksumAddrPtr					;Address Pointer LB
   355                      <       	CMP		#.LOW.D_NMIandResetVectorEndAddr	;End Low Byte
   356                      <       	BEQ		L_EndChecksum?
   357                      <       	
   358                      <       L_IncreaseAdd2?:
   359                      <       	INC		R_ChecksumAddrPtr					;Address Pointer LB
   360                      <       	BNE		L_ChecksumLoop2?
   361                      <       	INC		R_ChecksumAddrPtr + 1				;Address Pointer HB
   362                      <       	JMP		L_ChecksumLoop2?	
   363                      <       	
   364                      <       L_EndChecksum?:
   365                      <       
   366                      <       	.ENDM
