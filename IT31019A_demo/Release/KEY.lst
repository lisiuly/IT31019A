   605                      <       ;-----------------------------------------------------------------------------		
   606                      <       %M_PushAll:		.MACRO
   607                      <       		PHP
   608                      <       		PHA
   609                      <       		TXA
   610                      <       		PHA
   611                      <       		TYA
   612                      <       		PHA
   613                      <       			.ENDM
