   873 000000B2 FF FF               R_NormTempF	ds	2	;默认温度值
   874 000000B4 FF FF               R_NormHum	ds	2	;默认湿度值
   875 000000B6 FF                  R_AutoBack	ds	1
   876                              
   877 000000B7 FF                  R_TimeStatus		ds	1
   878                              AddOthers		equ		0x01
   879                              
   880 000000B8 FF                  R_BLightTime		ds	1
   881                              .ENDS
   882                              
   883                              ;=====================================================
   884 0000F03C                     .CODE
   885                              ;------------------------------------------
   886 0000F03C                     F_KeyScan:
   887                              
   888 0000F03C A5 0A               		LDA		P_IO_PortD_Data		;
   889                              ;		EOR		#D_Bit5;(D_Bit2+D_Bit3+D_Bit5)
   890 0000F03E 29 20               		AND		#D_CFKey;(D_MaxMinKey+D_ClearKey+D_CFKey)
   891 0000F040 F0 10               		BEQ		Exit_KeyScan
   892                              
   893 0000F042 85 A8               		STA	R_KeyTemp
   894 0000F044 C5 A9               		CMP	R_KeyValue
   895 0000F046 F0 2E               		BEQ	CheckKeyDebounce
   896                              		
   897 0000F048 A5 A8                		LDA	R_KeyTemp
   898 0000F04A 85 A9                		STA	R_KeyValue
   899 0000F04C A9 04                		LDA	#C_KeyDebounce
   900 0000F04E 85 AB                		STA	R_DebounceCnt
   901                               ;		%bitr	R_KeyFlag,D_KeyRelDis
   902 0000F050 58                  		CLI
   903 0000F051 60                  		RTS
   904                              		
   905 0000F052                     Exit_KeyScan:
   906                               		%btst	R_KeyFlag,(D_KeyRelDis+D_KeyFastAdd),?L_ClearKeyFlag
   907 0000F052 A5 AD             1           lda     R_KeyFlag               ;ex.   
   908 0000F054 29 05             1           and     #(D_KeyRelDis+D_KeyFastAdd)              ;  %btst 10H,_BIT0,N
   909 0000F056 D0 0B             1           bne     ?L_ClearKeyFlag               ;  if(10H.0=1) goto N 
   910 0000F058 A5 AA                		LDA		R_OldKeyValue
   911 0000F05A F0 07                		BEQ		?L_ClearKeyFlag
   912 0000F05C C9 20                		CMP		#D_CFKey
   913 0000F05E D0 03               		BNE		$+5
   914 0000F060 4C BB F0             		JMP		Enable_CFKey
   915 0000F063                      	?L_ClearKeyFlag:		
   916 0000F063 A9 00                		LDA	#00
   917 0000F065 85 AA                		STA	R_OldKeyValue
   918 0000F067 85 A9                		STA	R_KeyValue
   919 0000F069 85 AC                		STA	R_LongKeyTime
   920 0000F06B A9 04                		LDA	#C_KeyDebounce
   921 0000F06D 85 AB                		STA	R_DebounceCnt
   922                               		%bitr	R_KeyFlag,(D_LongKey+D_KeyRelDis+D_KeyFastAdd)
   923 0000F06F A5 AD             1           lda     R_KeyFlag               ;ex.  
   924 0000F071 29 F8             1           and     #.NOT.(D_LongKey+D_KeyRelDis+D_KeyFastAdd)         ;  %bitr 10H,_BIT0;  10H.0=0
   925 0000F073 85 AD             1           sta     R_KeyFlag
   926 0000F075 60                   		RTS
   927                              		
   928 0000F076                      CheckKeyDebounce:
   929 0000F076 A5 AB                		LDA	R_DebounceCnt	;键消抖时间到，才进入键功能。
   930 0000F078 F0 01                		BEQ	Key_Process		
   931 0000F07A 60                  		RTS				
   932 0000F07B                      Key_Process:
   933 0000F07B A5 A9               		LDA	R_KeyValue
   934 0000F07D C5 AA                		CMP	R_OldKeyValue
   935 0000F07F D0 03                		BNE	$+5
   936 0000F081 4C 89 F0             		JMP	Hold_Key
   937                              
   938 0000F084                      Enable_Key:
   939                              ; 		LDA	#C_LongKey2Sec
   940                              ; 		STA	R_LongKeyTime				;长按2秒开始计时
   941 0000F084 A5 A9                		LDA		R_KeyValue
   942 0000F086 85 AA                		STA		R_OldKeyValue
   943 0000F088                      	?Exit:
   944 0000F088 60                   		RTS	
   945                              		
   946                              		
   947 0000F089                     Hold_Key:		
   948 0000F089 60                   		RTS
   949                              		
   950                              ; ;================================================================
   951 0000F08A                      F_UpdataKey:
   952                              		%bits	R_KeyFlag,D_KeyRelDis	;置松键标志		
   953 0000F08A A5 AD             1           lda     R_KeyFlag               ;ex.  
   954 0000F08C 09 04             1           ora     #D_KeyRelDis              ;  %bits 10H,_BIT0  ;  10H.0=1
   955 0000F08E 85 AD             1           sta     R_KeyFlag               ;
   956                              		%bits	R_TimeStatus,AddOthers
   957 0000F090 A5 B7             1           lda     R_TimeStatus               ;ex.  
   958 0000F092 09 01             1           ora     #AddOthers              ;  %bits 10H,_BIT0  ;  10H.0=1
   959 0000F094 85 B7             1           sta     R_TimeStatus               ;
   960                              			
   961 0000F096 60                   		RTS
   962                              
   963 0000F097                     	Light_JudgeOff:
   964                              		%btsf	R_OtherFlag,D_BLight,?Exit
   965 0000F097 A5 AE             1           lda     R_OtherFlag               ;ex.   
   966 0000F099 29 01             1           and     #D_BLight              ;  %btsf 10H,_BIT0,N
   967 0000F09B F0 0E             1           beq     ?Exit               ;  if(10H.0=0) goto N 
   968 0000F09D C6 B8               		DEC		R_BLightTime
   969 0000F09F D0 0A               		BNE		?Exit
   970 0000F0A1                     	?OFF:
   971                              		%bitr	R_OtherFlag,D_BLight
   972 0000F0A1 A5 AE             1           lda     R_OtherFlag               ;ex.  
   973 0000F0A3 29 FE             1           and     #.NOT.D_BLight         ;  %bitr 10H,_BIT0;  10H.0=0
   974 0000F0A5 85 AE             1           sta     R_OtherFlag
   975                              ; 		LDA		P_IO_PortD_Data
   976                              ;		AND		#~D_Bit7;
   977                               ;		STA		P_IO_PortD_Data	
   978 0000F0A7 A9 2C               		LDA		#00101100b		
   979 0000F0A9 85 0A               		STA		P_IO_PortD_Data	 		
   980 0000F0AB                     		?Exit:
   981 0000F0AB 60                  			RTS
   982 0000F0AC                     F_JudgeBLightOnOff:
   983                              		%bits	R_OtherFlag,D_BLight
   984 0000F0AC A5 AE             1           lda     R_OtherFlag               ;ex.  
   985 0000F0AE 09 01             1           ora     #D_BLight              ;  %bits 10H,_BIT0  ;  10H.0=1
   986 0000F0B0 85 AE             1           sta     R_OtherFlag               ;
   987 0000F0B2 A9 0A               		LDA		#0x0a
   988 0000F0B4 85 B8               		STA		R_BLightTime			;赋值背光时长
   989                              ;		LDA		P_IO_PortD_Data
   990                              ;		ORA		#D_Bit7
   991                              ; 		STA		P_IO_PortD_Data	
   992 0000F0B6 A9 AC               		LDA		#10101100b		
   993 0000F0B8 85 0A               		STA		P_IO_PortD_Data				
   994 0000F0BA                      	?Exit:
   995 0000F0BA 60                  		RTS		
   996                              		
   997 0000F0BB                     Enable_CFKey:
   998                               	%btst	R_KeyFlag,D_KeyRelDis,?Exit
   999 0000F0BB A5 AD             1           lda     R_KeyFlag               ;ex.   
  1000 0000F0BD 29 04             1           and     #D_KeyRelDis              ;  %btst 10H,_BIT0,N
  1001 0000F0BF D0 0C             1           bne     ?Exit               ;  if(10H.0=1) goto N 
  1002 0000F0C1 20 8A F0            		JSR		F_UpdataKey
  1003 0000F0C4 20 AC F0             		JSR		F_JudgeBLightOnOff		
  1004 0000F0C7 A5 AE               		LDA		R_OtherFlag
  1005 0000F0C9 49 02               		EOR		#D_CF
  1006 0000F0CB 85 AE                		STA		R_OtherFlag
  1007 0000F0CD                      	?Exit:
  1008                              		
  1009 0000F0CD 60                  		RTS
  1010                              
