   615                      <       ; Macro Name:	%M_PopAll
   616                      <       ; Description:	Pop
   617                      <       ;-----------------------------------------------------------------------------	
   618                      <       %M_PopAll:		.MACRO
   619                      <       		PLA
   620                      <       		TAY
   621                      <       		PLA
   622                      <       		TAX
   623                      <       		PLA
   624                      <       		PLP
   625                      <       			.ENDM	
