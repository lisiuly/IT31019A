   689                              ;----------------------------------------------------------------------------
   690                              ; Name:	%HumDataRecordDef
   691                              ; Description: Define data structure for humidity data table
   692                              ; Input: c_coditionTemper <- temperature
   693                              ;        c_tableAddrStart <- table start address   
   694                              ;        c_tablelen       <- data table length
   695                              ;----------------------------------------------------------------------------
   696                              %HumDataRecordDef   .MACRO  c_coditionTemper, c_tableAddrStart, c_tablelen
   697                              .IFNDEF HUM_DATARECORD_START
   698                              HUM_DATARECORD_START    EQU     $
   699                              .ENDIF
   700                                      DB      c_coditionTemper    ;The specific temperature condition
   701                                      DW      c_tableAddrStart    ;The specific data table start address
   702                                      DB      c_tablelen          ;data table length (byte)
   703                              
   704                              .IFNDEF HUM_DATARECORD_SIZE
   705                              HUM_DATARECORD_SIZE:    EQU     $ - HUM_DATARECORD_START
   706                              .ENDIF
   707                              .ENDM
   708                              
   709 0000F259                     RFC_Hum   .section
   710                                  .INCLUDE        humidity3bytes.tab
   711                      <       ;============================================================================
   712                      <       ;File Name:	    humidity.tab
   713                      <       ;Applied body:	GPLxx
   714                      <       ;Purpose:		Provide R-H data table of humidity sensor (GHR01-2530)
   715                      <       ;Programmer:	yangff
   716                      <       ;Date:			2010-01-28
   717                      <       ;Note:          The sensor circuit should be modified as following connection
   718                      <       ;               IO pin ------- Humidity Sensor  ----- 510 ohm Resistor ---
   719                      <       ;                         |                       |                      |
   720                      <       ;                         |--- 1 Mohm Resistor  --|                 Capacitor
   721                      <       ;                                                                        |
   722                      <       ;                                                                        |
   723                      <       ;                                                                     Ground
   724                      <       ;============================================================================
