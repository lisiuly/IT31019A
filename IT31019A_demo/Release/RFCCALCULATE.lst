   491                      <       D_RFC_ScanDataReady		.EQU		00001000B		;Bit3
   492                      <       D_RFC_ContinueSacn		.EQU		00010000B		;Bit4
   493                      <       D_RFC_CalculateDone		.EQU		00100000B		;Bit5
   494                      <       D_RFC_TempDataReady		.EQU		01000000B		;Bit6
   495                      <       D_RFC_SensorEn			.EQU		10000000B		;Bit6
   496                      <       
   497                      <       ;0:Idle
   498                      <       ;1:Sensing Ref
   499                      <       ;2:Read Ref data and Sensing Sens1	
   500                      <       ;3:Read Sens1 data and Sensing Sens2
   501                      <       ;4:Read Sens2 data
   502                      <       
   503                      <       ;Bit3:RFC Data Readay flag
   504                      <       ;Bit4:Continue Sensing RFC Data
   505                      <       ;Bit5:Accept Disaply RFC Data
