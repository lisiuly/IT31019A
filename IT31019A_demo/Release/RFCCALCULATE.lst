   482                      <       ;R_RFC_States
   483                      <       ;Bit0~2 for state machine
   484                      <       D_RFC_ScanIdle			.EQU		0
   485                      <       D_RFC_ScanRef			.EQU		1
   486                      <       D_RFC_ScanSen1			.EQU		2		;Read Ref data & Scan Sensor1
   487                      <       D_RFC_ScanSen2			.EQU		3		;Read Sensor1 data & Scan Sensor2
   488                      <       D_RfcStatTempCalc		.EQU		4		;Read Sensor2 data
   489                      <       D_RfcStatHumCalc		.EQU		5
