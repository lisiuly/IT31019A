	DB	C_Com0MinByteNum+Seg07/8,C_Seg07 ;c
	DB	C_Com0MinByteNum+Seg08/8,C_Seg08 ;d
	DB	C_Com1MinByteNum+Seg08/8,C_Seg08 ;e
