	DB	C_Com3MinByteNum+Seg08/8,C_Seg08 ;b
	DB	C_Com1MinByteNum+Seg09/8,C_Seg09 ;c
	DB	C_Com0MinByteNum+Seg09/8,C_Seg09 ;d
	DB	C_Com0MinByteNum+Seg10/8,C_Seg10 ;e
