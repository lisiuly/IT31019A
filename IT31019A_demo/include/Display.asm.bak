;======================================================
.CODE
;------------------------------
;C_NotDispThisDigital	EQU	0AH
;==============================
T_SevenSegCharPosIndexTab:
	DW	T_Digital1DispTab   ;1		;HourH
	DW	T_Digital2DispTab   ;2		;HourL
	DW	T_Digital3DispTab   ;3		;MinH
	DW	T_Digital4DispTab   ;4		;MinL
	DW	T_Digital5DispTab   ;5		;MinL
	DW	T_Digital6DispTab   ;6		;MinL
	DW	T_Digital7DispTab   ;7		;MinL
;=======================
T_SevenSegCharBitMapTab:
;	       0,         1,       2,        3,        4
	DB	00111111B,00000110B,01011011B,01001111B,01100110B
;	       5,         6,       7,        8,        9
	DB	01101101B,01111101B,00000111B,01111111B,01101111B
;	      A-"A"     B-"b"     C-"C"    D-'L'       E-'E'      
	DB	01110111B,01111100B,00111001B,00111000B,01111001B
;		F;'NULL'  	10-"r"	11-"Dash"
	DB	00000000B,01010000B,01000000B
;---
;format:byte index;mask bit
;---
; ================================
	;实际LCD
;.comment	
; ================================
; ================================
T_Digital1DispTab:   ;;0 Time minH
	DB	C_Com0MinByteNum+Seg03/8,C_Seg03 ;a
	DB	C_Com0MinByteNum+Seg04/8,C_Seg04 ;b
	DB	C_Com0MinByteNum+Seg07/8,C_Seg07 ;c
	DB	C_Com0MinByteNum+Seg09/8,C_Seg09 ;d
	DB	C_Com0MinByteNum+Seg08/8,C_Seg08 ;e
	DB	C_Com0MinByteNum+Seg05/8,C_Seg05 ;f 
	DB	C_Com0MinByteNum+Seg06/8,C_Seg06 ;g
T_Digital1DispTabEnd:
; ================================
