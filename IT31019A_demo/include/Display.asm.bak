T_ICON:

T_BAT1	EQU	$-T_ICON
	DB	C_Com0MinByteNum+Seg02/8,C_Seg02 ;	外壳
T_BAT2	EQU	$-T_ICON
	DB	C_Com2MinByteNum+Seg02/8,C_Seg02 ;	电池芯1	
T_BAT3	EQU	$-T_ICON
	DB	C_Com3MinByteNum+Seg02/8,C_Seg02 ;	电池芯2
T_BAT4	EQU	$-T_ICON
	DB	C_Com1MinByteNum+Seg02/8,C_Seg02 ;	电池芯3
		
T_Lock	EQU	$-T_ICON
	DB	C_Com5MinByteNum+Seg02/8,C_Seg02 ;
T_CHAN	EQU	$-T_ICON
	DB	C_Com2MinByteNum+Seg00/8,C_Seg00 ;
		
.END
